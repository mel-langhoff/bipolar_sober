<% content_for :title, "Chronic Pain Relapse Plan | Bipolar Sober" %>

<main class="relapse-plan-page">

  <section class="relapse-plan-hero">
    <div class="relapse-plan-container">
      <%= link_to "← ALL RELAPSE PLANS", toolbox_relapse_plans_path,
          class: "relapse-plan-back" %>

      <p class="relapse-plan-eyebrow">
        BIPOLAR SOBER / RELAPSE PLANS / CHRONIC PAIN
      </p>

      <h1>
        <span>IT HURTS.</span>
        <span>YOU WANT</span>
        <span>A BREAK.</span>
      </h1>

      <p class="relapse-plan-intro">
        MY SOBRIETY PLAN FOR PAIN FLARES &amp; HARD BODY DAYS.
      </p>
    </div>
  </section>

  <section class="relapse-plan-section relapse-plan-yellow">
    <div class="relapse-plan-container">
      <p class="relapse-plan-label">01 / PAIN &amp; DRINKING</p>
      <h2>WHAT I WANT<br>RELIEF FROM.</h2>

      <div class="relapse-plan-copy">
        <p>[Write about your pain, its impact, and the role alcohol has played.]</p>
      </div>
    </div>
  </section>

  <section class="relapse-plan-section relapse-plan-black">
    <div class="relapse-plan-container">
      <p class="relapse-plan-label">02 / MY RELAPSE WARNING SIGNS</p>
      <h2>WHEN PAIN<br>STARTS BARGAINING.</h2>

      <div class="relapse-plan-grid">
        <div class="relapse-plan-box">
          <h3>THE BODY PART</h3>
          <p>[Write the pain situations that tend to bring up drinking urges.]</p>
        </div>

        <div class="relapse-plan-box">
          <h3>THE EMOTIONAL PART</h3>
          <p>[Write about frustration, limitations, exhaustion, or your own experience.]</p>
        </div>
      </div>
    </div>
  </section>

  <section class="relapse-plan-section relapse-plan-pink">
    <div class="relapse-plan-container">
      <p class="relapse-plan-label">03 / MY FLARE-DAY PLAN</p>
      <h2>WORK WITH<br>TODAY’S BODY.</h2>

      <div class="relapse-plan-grid">
        <div class="relapse-plan-box">
          <h3>MY ESTABLISHED PAIN PLAN</h3>
          <p>[Add the care instructions and options agreed with your clinician.]</p>
        </div>

        <div class="relapse-plan-box">
          <h3>WHAT CAN WAIT</h3>
          <p>[Write the expectations and tasks you can adjust on a flare day.]</p>
        </div>

        <div class="relapse-plan-box">
          <h3>SUPPORT I CAN ASK FOR</h3>
          <p>[Write the practical help you need and who you can ask.]</p>
        </div>

        <div class="relapse-plan-box">
          <h3>MY DRINKING-URGE PLAN</h3>
          <p>[Write your immediate actions when pain brings up an urge to drink.]</p>
        </div>
      </div>
    </div>
  </section>

  <section class="relapse-plan-section relapse-plan-purple">
    <div class="relapse-plan-container">
      <p class="relapse-plan-label">04 / WHEN THE PLAN NEEDS HELP</p>
      <h2>WHO DO<br>I CONTACT?</h2>

      <div class="relapse-plan-grid">
        <div class="relapse-plan-box">
          <h3>MY RECOVERY SUPPORT</h3>
          <p>[Add contacts and your backup.]</p>
        </div>

        <div class="relapse-plan-box">
          <h3>MY MEDICAL CONTACTS &amp; INSTRUCTIONS</h3>
          <p>[Add clinician-provided guidance for changing symptoms and urgent care.]</p>
        </div>
      </div>
    </div>
  </section>

</main>