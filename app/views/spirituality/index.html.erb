<% content_for :title, "Spirituality | Bipolar Sober" %>

<main class="spirituality-page">

  <!-- HERO -->
  <section class="spirituality-hero">
    <div class="spirituality-hero-content">

      <p class="spirituality-eyebrow">
        BIPOLAR SOBER / SPIRITUALITY
      </p>

      <h1>
        <span>ON</span>
        <span>SPIRITUALITY.</span>
      </h1>

      <p class="spirituality-intro">
        YOU DON'T HAVE TO HAVE<br>
        ALL THE FUCKING ANSWERS.
      </p>

    </div>
  </section>


  <!-- TOPICS -->
  <section class="spirituality-topics" id="spirituality-topics">

    <div class="spirituality-topics-heading">

      <p>01 / SPIRITUALITY</p>

      <h2>
        FIND YOUR<br>
        OWN WAY.
      </h2>

      <p class="spirituality-topics-subtitle">
        Take what speaks to you. Question what doesn't.
        Spirituality doesn't have to fit neatly inside one box.
      </p>

    </div>


    <div class="spirituality-grid">

      <!-- 01 / MY SPIRITUALITY -->
      <%= link_to spirituality_my_spirituality_path,
          class: "spirituality-card spirituality-card-black" do %>

        <p class="spirituality-card-number">01</p>

        <h3>
          MY<br>
          SPIRITUALITY
        </h3>

        <p class="spirituality-card-description">
          The universe. Nature. Energy. Guardian spirits.
          Ritual, connection, mystery, and my own way of
          relating to something bigger than myself.
        </p>

        <span>MY PERSPECTIVE →</span>

      <% end %>


      <!-- 02 / BUDDHISM -->
      <%= link_to spirituality_buddhism_path,
          class: "spirituality-card spirituality-card-pink" do %>

        <p class="spirituality-card-number">02</p>

        <h3>
          BUDDHISM
        </h3>

        <p class="spirituality-card-description">
          Suffering, craving, attachment, impermanence, mindfulness,
          compassion, and learning how to sit with life instead of
          constantly trying to escape it.
        </p>

        <span>EXPLORE →</span>

      <% end %>


      <!-- 03 / HINDUISM -->
      <%= link_to spirituality_hinduism_path,
          class: "spirituality-card spirituality-card-yellow" do %>

        <p class="spirituality-card-number">03</p>

        <h3>
          HINDUISM
        </h3>

        <p class="spirituality-card-description">
          Dharma, karma, the Self, spiritual discipline,
          the Bhagavad Gita, and ancient ideas about living,
          acting, suffering, and letting go of outcomes.
        </p>

        <span>EXPLORE →</span>

      <% end %>


      <!-- 04 / SHINTO -->
      <%= link_to spirituality_shinto_path,
          class: "spirituality-card spirituality-card-purple" do %>

        <p class="spirituality-card-number">04</p>

        <h3>
          SHINTO
        </h3>

        <p class="spirituality-card-description">
          Kami, shrines, purification, offerings, and reverence
          for the natural world. Exploring sacred relationships
          through gratitude, ritual, and everyday care.
        </p>

        <span>EXPLORE →</span>

      <% end %>


      <!-- 05 / PAGANISM -->
      <%= link_to spirituality_paganism_path,
          class: "spirituality-card spirituality-card-pink" do %>

        <p class="spirituality-card-number">05</p>

        <h3>
          PAGANISM
        </h3>

        <p class="spirituality-card-description">
          Diverse paths involving nature, deities, ancestors,
          seasonal cycles, and ritual. Exploring connection
          through the living world and personal practice.
        </p>

        <span>EXPLORE →</span>

      <% end %>

    </div>

  </section>

</main>