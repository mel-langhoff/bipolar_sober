<% content_for :title, "Perspectives | Bipolar Sober" %>

<main class="perspectives-page">

  <!-- HERO -->
  <section class="perspectives-hero">

    <div class="perspectives-hero-content">

      <p class="perspectives-eyebrow">
        BIPOLAR SOBER / PERSPECTIVES
      </p>

      <h1>
        <span>CHANGE</span>
        <span>THE FUCKING</span>
        <span>ANGLE.</span>
      </h1>

      <p class="perspectives-intro">
        THOUGHTS. BOOKS. QUOTES.<br>
        NOTES FROM THE INSIDE.<br>
        THINGS THAT MADE ME LOOK TWICE.
      </p>

    </div>

  </section>


  <!-- TOPICS -->
  <section class="perspectives-topics">

    <div class="perspectives-topics-heading">

      <p>01 / PERSPECTIVES</p>

      <h2>
        ANOTHER<br>
        WAY TO<br>
        LOOK AT IT.
      </h2>

      <p class="perspectives-topics-subtitle">
        Things I've read. Things I've written.
        Things I've lived through. Things that changed
        the way I look at myself, recovery, and everything else.
      </p>

    </div>


    <div class="perspectives-grid">


      <!-- 01 / REFLECTIONS -->
      <%= link_to perspectives_reflections_path,
          class: "perspectives-card perspectives-card-pink" do %>

        <p class="perspectives-card-number">01</p>

        <h3>
          REFLECTIONS
        </h3>

        <p class="perspectives-card-description">
          Thoughts, lessons, questions, contradictions,
          and shit I've figured out — or am still trying
          to figure out.
        </p>

        <span>READ →</span>

      <% end %>


      <!-- 02 / BOOKS -->
      <%= link_to perspectives_books_path,
          class: "perspectives-card perspectives-card-yellow" do %>

        <p class="perspectives-card-number">02</p>

        <h3>
          BOOKS
        </h3>

        <p class="perspectives-card-description">
          Books that made me stop, underline something,
          argue with the author, rethink something,
          or carry an idea with me afterward.
        </p>

        <span>OPEN THE STACK →</span>

      <% end %>


      <!-- 03 / QUOTES -->
      <%= link_to perspectives_quotes_path,
          class: "perspectives-card perspectives-card-purple" do %>

        <p class="perspectives-card-number">03</p>

        <h3>
          QUOTES
        </h3>

        <p class="perspectives-card-description">
          Words worth keeping — and what they actually
          mean to me beyond looking profound on the internet.
        </p>

        <span>READ →</span>

      <% end %>


      <!-- 04 / ON THE INSIDE -->
      <%= link_to perspectives_inside_path,
          class: "perspectives-card perspectives-card-black" do %>

        <p class="perspectives-card-number">04</p>

        <h3>
          ON THE<br>
          INSIDE
        </h3>

        <p class="perspectives-card-description">
          Notes from jail. What I saw, what I felt,
          what I wrote down, and what I never want
          to fucking forget.
        </p>

        <span>GO INSIDE →</span>

      <% end %>


    </div>

  </section>

</main>