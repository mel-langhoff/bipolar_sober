<main class="resources-page">

  <section class="resources-hero">
    <p class="resources-eyebrow">
      BIPOLAR SOBER / RESOURCES
    </p>

    <h1>
      <span>HELP IS</span>
      <span>ALWAYS</span>
      <span>ON THE WAY.</span>
    </h1>

    <p class="resources-intro">
      We're in this together.
    </p>

    <a href="#resources" class="resources-button">
      FIND SOMETHING ↓
    </a>
  </section>


  <section class="resources-list" id="resources">

    <div class="resources-heading">
      <p>01 / RESOURCES</p>
      <h2>WHAT DO<br>YOU NEED?</h2>
    </div>


    <div class="resource-grid">

      <%= link_to so_you_want_to_drink_path, class: "resource-card featured-resource" do %>
        <p class="resource-number">01</p>

        <h3>
          SO YOU<br>
          WANT TO<br>
          DRINK?
        </h3>

        <p class="resource-description">
          Before you pick up a drink, remember where you've already been.
        </p>

        <span class="resource-link">
          READ THIS →
        </span>
      <% end %>


      <article class="resource-card coming-soon">
        <p class="resource-number">02</p>

        <h3>
          MORE<br>
          COMING.
        </h3>

        <p class="resource-description">
          More tools, exercises, and things that might actually help.
        </p>

        <span class="resource-link">
          COMING SOON
        </span>
      </article>

    </div>

  </section>

</main>