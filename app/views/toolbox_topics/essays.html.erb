<% content_for :title, "Essays | Bipolar Sober" %>

<main class="iop-page essays-page">

  <!-- HERO -->
  <section class="iop-hero">

    <div class="iop-hero-content">

      <p class="iop-eyebrow">
        BIPOLAR SOBER / PERSPECTIVES / ESSAYS
      </p>

      <h1>
        <span>THE WORK</span>
        <span>YOU CHOSE</span>
        <span>TO DO.</span>
      </h1>

      <p class="iop-tagline">
        YOUR WORDS.<br>
        YOUR PERSPECTIVE.
      </p>

      <p class="iop-intro">
        IOP WRITING. PERSONAL ESSAYS.<br>
        THINGS YOU WANTED TO FIGURE OUT.
      </p>

    </div>

  </section>


  

  <!-- ESSAY CARDS -->
  <section class="iop-library">

    <div class="iop-inner">

      <p class="iop-number">01 / THE ESSAYS</p>

      <h2>
        OPEN<br>
        THE FILES.
      </h2>

      <div class="iop-grid">

        <!-- IOP ESSAYS -->
        <%= link_to iop_essays_path,
            class: "iop-card iop-card-pink" do %>

          <p class="iop-card-number">01</p>

          <p class="iop-card-label">
            TWELVE WEEKS / ORIGINAL WRITING
          </p>

          <h3>
            IOP<br>
            ESSAYS.
          </h3>

          <p class="iop-card-description">
            Twelve weeks of writing from intensive outpatient treatment:
            what you explored, questioned, and chose to put into words.
          </p>

          <span class="iop-card-action">
            READ THE IOP ESSAYS →
          </span>

        <% end %>


        <!-- RISING IN THE EAST -->
        <article class="iop-card iop-card-yellow">

          <p class="iop-card-number">02</p>

          <p class="iop-card-label">
            PERSONAL ESSAY / IN DEVELOPMENT
          </p>

          <h3>
            RISING<br>
            IN THE<br>
            EAST.
          </h3>

          <p class="iop-card-description">
            Eastern philosophy, bipolar disorder, and addiction:
            exploring how these traditions speak to the life you’re
            actually trying to live.
          </p>

          <span class="iop-card-action">
            IN DEVELOPMENT
          </span>

        </article>


        <!-- WISDOM IN UNEXPECTED PLACES -->
        <article class="iop-card iop-card-purple">

          <p class="iop-card-number">03</p>

          <p class="iop-card-label">
            PERSONAL ESSAY / IN DEVELOPMENT
          </p>

          <h3>
            TURN<br>
            EVERY<br>
            STONE.
          </h3>

          <p class="iop-card-description">
            Finding ideas about sobriety and mental health in books,
            people, stories, and places you didn’t expect to learn from.
          </p>

          <span class="iop-card-action">
            IN DEVELOPMENT
          </span>

        </article>


        <!-- CD PLAYA -->
        <article class="iop-card iop-card-black">

          <p class="iop-card-number">04</p>

          <p class="iop-card-label">
            PERSONAL ESSAY / IN DEVELOPMENT
          </p>

          <h3>
            CD<br>
            PLAYA.
          </h3>

          <p class="iop-card-description">
  Cognitive distortions know how to run game on you—
  and rig the whole damn game so you lose.
</p>

          <span class="iop-card-action">
            IN DEVELOPMENT
          </span>

        </article>


        <!-- CUFFED -->
        <article class="iop-card iop-card-pink">

          <p class="iop-card-number">05</p>

          <p class="iop-card-label">
            PERSONAL ESSAY / IN DEVELOPMENT
          </p>

          <h3>
            CUFFED.
          </h3>

          <p class="iop-card-description">
            An essay about jail in place of treatment—and what gets
            missed when mental illness and addiction are handled as
            criminal problems.
          </p>

          <span class="iop-card-action">
            IN DEVELOPMENT
          </span>

        </article>


        <!-- BLITZKRIEG BOP -->
<article class="iop-card iop-card-yellow">

  <p class="iop-card-number">06</p>

  <p class="iop-card-label">
    PERSONAL ESSAY / IN DEVELOPMENT
  </p>

  <h3>
    BLITZKRIEG<br>
    BOP.
  </h3>

  <p class="iop-card-description">
    A look at impulsivity at full speed—and the common ground
    it shares across addiction, bipolar disorder, and ADHD.
  </p>

  <span class="iop-card-action">
    IN DEVELOPMENT
  </span>

</article>


      </div>

    </div>

  </section>


  <!-- ENDING -->
  <section class="iop-ending">

    <p>
      YOUR WORDS.<br>
      YOUR PERSPECTIVE.
    </p>

    <h2>
      KEEP<br>
      ON<br>
      WRITING.
    </h2>

     <%= link_to "← BACK TO PERSPECTIVES",
        perspectives_path,
        class: "pb-back-link" %>

  </section>

</main>