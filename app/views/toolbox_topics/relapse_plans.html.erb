<% content_for :title, "Relapse Plans | Bipolar Sober" %>

<main class="relapse-hub">

  <!-- HERO -->
  <section class="relapse-hub-hero">
    <div class="relapse-hub-container">

      <%= link_to "← BACK TO THE TOOLBOX",
          toolbox_path,
          class: "relapse-hub-back" %>

      <p class="relapse-hub-eyebrow">
        BIPOLAR SOBER / RELAPSE PLANS
      </p>

      <h1>
        MAKE A PLAN.<br>
        YOUR BRAIN<br>
        HAS OTHER IDEAS.
      </h1>

      <p class="relapse-hub-intro">
        Different triggers. Different plans.
        Pick what’s happening.
      </p>

    </div>
  </section>

  <!-- YOUR INTRODUCTION -->
  <section class="relapse-hub-note">
    <div class="relapse-hub-container">
      <p class="relapse-hub-label">01 / BEFORE THE BARGAINING STARTS</p>

      <h2>
        A LITTLE<br>
        PREPARATION.
      </h2>

      <div class="relapse-hub-copy">
        <p>
          [Your introduction goes here. What these plans are for,
          how you use them, and what you want someone to know
          before choosing one.]
        </p>
      </div>
    </div>
  </section>

  <!-- PLAN DIRECTORY -->
  <section class="relapse-hub-plans">
    <div class="relapse-hub-container">

      <div class="relapse-hub-heading">
        <p class="relapse-hub-label">02 / PICK YOUR PLAN</p>

        <h2>
          WHAT’S GOING<br>
          ON RIGHT NOW?
        </h2>

        <p>
          You can need more than one. There’s no prize
          for making this shit fit neatly into a box.
        </p>
      </div>

      <div class="relapse-hub-grid">

        <%= link_to relapse_plan_mania_path,
            class: "relapse-hub-card relapse-hub-card-pink" do %>
          <p class="relapse-hub-number">01 / MANIA &amp; HYPOMANIA</p>
          <h3>
            FEELING<br>
            FUCKING<br>
            INVINCIBLE?
          </h3>
          <p class="relapse-hub-description">
            A drinking relapse prevention plan for when
            your mood is heading up.
          </p>
          <span class="relapse-hub-cta">OPEN THE PLAN →</span>
        <% end %>

        <%= link_to relapse_plan_depression_path,
            class: "relapse-hub-card relapse-hub-card-purple" do %>
          <p class="relapse-hub-number">02 / DEPRESSION</p>
          <h3>
            WHEN<br>
            EVERYTHING<br>
            FEELS HEAVY.
          </h3>
          <p class="relapse-hub-description">
            A drinking relapse prevention plan for
            the low days.
          </p>
          <span class="relapse-hub-cta">OPEN THE PLAN →</span>
        <% end %>

        <%= link_to relapse_plan_mixed_symptoms_path,
            class: "relapse-hub-card relapse-hub-card-yellow" do %>
          <p class="relapse-hub-number">03 / MIXED SYMPTOMS</p>
          <h3>
            WIRED.<br>
            MISERABLE.<br>
            NOW WHAT?
          </h3>
          <p class="relapse-hub-description">
            A drinking relapse prevention plan for
            when things feel up and down at once.
          </p>
          <span class="relapse-hub-cta">OPEN THE PLAN →</span>
        <% end %>

        <%= link_to relapse_plan_impulsivity_path,
            class: "relapse-hub-card relapse-hub-card-black" do %>
          <p class="relapse-hub-number">04 / IMPULSIVITY</p>
          <h3>
            BEFORE<br>
            "FUCK IT"<br>
            TAKES OVER.
          </h3>
          <p class="relapse-hub-description">
            A drinking relapse prevention plan for
            the act-now, think-later moments.
          </p>
          <span class="relapse-hub-cta">OPEN THE PLAN →</span>
        <% end %>

        <%= link_to relapse_plan_chronic_pain_path,
            class: "relapse-hub-card relapse-hub-card-yellow" do %>
          <p class="relapse-hub-number">05 / CHRONIC PAIN</p>
          <h3>
            IT HURTS.<br>
            YOU WANT<br>
            A BREAK.
          </h3>
          <p class="relapse-hub-description">
            A drinking relapse prevention plan for
            pain flares and exhausting body days.
          </p>
          <span class="relapse-hub-cta">OPEN THE PLAN →</span>
        <% end %>

        <%= link_to relapse_plan_boredom_path,
            class: "relapse-hub-card relapse-hub-card-pink" do %>
          <p class="relapse-hub-number">06 / BOREDOM &amp; RESTLESSNESS</p>
          <h3>
            BORED<br>
            OUT OF YOUR<br>
            FUCKING SKULL?
          </h3>
          <p class="relapse-hub-description">
            A drinking relapse prevention plan for
            empty hours and wanting something to happen.
          </p>
          <span class="relapse-hub-cta">OPEN THE PLAN →</span>
        <% end %>

        <%= link_to relapse_plan_anger_path,
            class: "relapse-hub-card relapse-hub-card-purple" do %>
          <p class="relapse-hub-number">07 / ANGER &amp; CONFLICT</p>
          <h3>
            PISSED OFF.<br>
            STILL<br>
            SOBER.
          </h3>
          <p class="relapse-hub-description">
            A drinking relapse prevention plan for
            arguments, resentment, and seeing red.
          </p>
          <span class="relapse-hub-cta">OPEN THE PLAN →</span>
        <% end %>

        <%= link_to relapse_plan_loneliness_path,
            class: "relapse-hub-card relapse-hub-card-yellow" do %>
          <p class="relapse-hub-number">08 / LONELINESS &amp; ISOLATION</p>
          <h3>
            JUST YOU<br>
            AND YOUR<br>
            LOUD BRAIN.
          </h3>
          <p class="relapse-hub-description">
            A drinking relapse prevention plan for
            feeling alone or pulling away.
          </p>
          <span class="relapse-hub-cta">OPEN THE PLAN →</span>
        <% end %>

        <%= link_to relapse_plan_social_pressure_path,
            class: "relapse-hub-card relapse-hub-card-black" do %>
          <p class="relapse-hub-number">09 / SOCIAL PRESSURE &amp; CELEBRATIONS</p>
          <h3>
            EVERYONE’S<br>
            DRINKING.<br>
            AND?
          </h3>
          <p class="relapse-hub-description">
            A drinking relapse prevention plan for
            parties, celebrations, and "just have one."
          </p>
          <span class="relapse-hub-cta">OPEN THE PLAN →</span>
        <% end %>

        <%= link_to relapse_plan_after_drinking_path,
            class: "relapse-hub-card relapse-hub-card-pink" do %>
          <p class="relapse-hub-number">10 / AFTER DRINKING</p>
          <h3>
            I DRANK.<br>
            WHAT THE<br>
            FUCK NOW?
          </h3>
          <p class="relapse-hub-description">
            A plan for what comes next
            after you’ve already had a drink.
          </p>
          <span class="relapse-hub-cta">OPEN THE PLAN →</span>
        <% end %>

      </div>
    </div>
  </section>

  <!-- PERSONAL NOTES -->
  <section class="relapse-hub-footer">
    <div class="relapse-hub-container">
      <p class="relapse-hub-label">03 / MAKE IT YOURS</p>

      <h2>
        YOUR PATTERNS.<br>
        YOUR PEOPLE.<br>
        YOUR PLAN.
      </h2>

      <div class="relapse-hub-copy">
        <p>
          [Your closing content goes here. Add your thoughts
          on personal warning signs, support, and coming
          back to these plans.]
        </p>
      </div>
    </div>
  </section>

</main>