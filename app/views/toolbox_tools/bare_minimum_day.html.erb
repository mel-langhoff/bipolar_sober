        KEEP IT<br>
        FUCKING SIMPLE.
      </h2>

      <div class="minimum-copy">
        <p>[YOUR CONTENT GOES HERE.]</p>
      </div>

      <div class="minimum-grid">

        <div class="minimum-box">
          <h3>SOMETHING TO EAT.</h3>
          <p>[YOUR CONTENT GOES HERE.]</p>
        </div>

        <div class="minimum-box">
          <h3>SOMETHING TO DRINK.</h3>
          <p>[YOUR CONTENT GOES HERE.]</p>
        </div>

        <div class="minimum-box">
          <h3>PRESCRIBED MEDICATION.</h3>
          <p>[YOUR CONTENT GOES HERE.]</p>
        </div>

        <div class="minimum-box">
          <h3>BASIC COMFORT.</h3>
          <p>[YOUR CONTENT GOES HERE.]</p>
        </div>

      </div>

    </div>
  </section>


