<% content_for :title, "The Bare Minimum Day | Bipolar Sober" %>

<main class="minimum-page">

  <!-- HERO -->
  <section class="minimum-hero">

    <picture class="minimum-background" aria-hidden="true">
      <source
        media="(min-width: 768px)"
        srcset="<%= asset_path('toolbox_bare_minimum_day_desktop.png') %>"
      >
      <%= image_tag "toolbox_bare_minimum_day_mobile.png",
          alt: "",
          loading: "eager" %>
    </picture>

    <div class="minimum-hero-content">

      <p class="minimum-eyebrow">
        BIPOLAR SOBER / TOOLBOX / THE BARE MINIMUM DAY
      </p>

      <h1>
        <span>BARE MINIMUM.</span>
        <span>FULL CREDIT.</span>
      </h1>

      <p class="minimum-intro">
        [YOUR INTRO GOES HERE.]
      </p>

    </div>
  </section>


  <!-- 01 / TODAY'S CAPACITY -->
  <section class="minimum-section minimum-pink">
    <div class="minimum-inner">

      <p class="minimum-number">01 / TODAY'S CAPACITY</p>

      <h2>
        WHAT HAVE<br>
        YOU GOT<br>
        TODAY?
      </h2>

      <div class="minimum-copy">
        <p>[YOUR CONTENT GOES HERE.]</p>
      </div>

      <div class="minimum-callout">
        <p>[YOUR CHECK-IN PROMPT GOES HERE.]</p>
      </div>

    </div>
  </section>


