<% content_for :title, "Urgent According to Who? | Bipolar Sober" %>

<main class="urgency-page">

  <!-- HERO -->
  <section class="urgency-hero">

    <picture class="urgency-background" aria-hidden="true">
      <source
        media="(min-width: 768px)"
        srcset="<%= asset_path('toolbox_urgent_according_to_who_desktop.png') %>"
      >
      <%= image_tag "toolbox_urgent_according_to_who_mobile.png",
          alt: "",
          loading: "eager" %>
    </picture>

    <div class="urgency-hero-content">

      <p class="urgency-eyebrow">
        BIPOLAR SOBER / TOOLBOX / URGENT ACCORDING TO WHO?
      </p>

      <h1>
        <span>URGENT</span>
        <span>ACCORDING</span>
        <span>TO WHO?</span>
      </h1>

      <p class="urgency-intro">
        [YOUR INTRO GOES HERE.]
      </p>

    </div>
  </section>


  <!-- 01 / THE URGENCY -->
  <section class="urgency-section urgency-pink">
    <div class="urgency-inner">

      <p class="urgency-number">01 / THE URGENCY</p>

      <h2>
        WHAT CAN'T<br>
        FUCKING WAIT?
      </h2>

      <div class="urgency-copy">
        <p>[YOUR CONTENT GOES HERE.]</p>
      </div>

      <div class="urgency-callout">
        <p>[YOUR CHECK-IN PROMPT GOES HERE.]</p>
      </div>

    </div>
  </section>


  <!-- 02 / CHECK THE DEADLINE -->
  <section class="urgency-section urgency-black">
    <div class="urgency-inner">

      <p class="urgency-number">02 / CHECK THE DEADLINE</p>

      <h2>
        WHERE'S THE<br>
        ACTUAL DEADLINE?
      </h2>

      <div class="urgency-copy">
        <p>[YOUR CONTENT GOES HERE.]</p>
      </div>

      <div class="urgency-grid">

        <div class="urgency-box">
          <h3>WHAT NEEDS ACTION NOW?</h3>
          <p>[YOUR CONTENT GOES HERE.]</p>
        </div>

        <div class="urgency-box">
          <h3>WHAT JUST FEELS URGENT?</h3>
          <p>[YOUR CONTENT GOES HERE.]</p>
        </div>

      </div>

    </div>
  </section>


  <!-- 03 / CHECK YOUR PACE -->
  <section class="urgency-section urgency-yellow">
    <div class="urgency-inner">

      <p class="urgency-number">03 / CHECK YOUR PACE</p>

      <h2>
        HOW FAST<br>
        ARE YOU GOING?
      </h2>

      <div class="urgency-copy">
        <p>[YOUR CONTENT GOES HERE.]</p>
      </div>

      <div class="urgency-grid">

        <div class="urgency-box">
          <h3>SLEEP & ENERGY.</h3>
          <p>[YOUR CONTENT GOES HERE.]</p>
        </div>

        <div class="urgency-box">
          <h3>THOUGHTS & PLANS.</h3>
          <p>[YOUR CONTENT GOES HERE.]</p>
        </div>

        <div class="urgency-box">
          <h3>SPENDING & COMMITMENTS.</h3>
          <p>[YOUR CONTENT GOES HERE.]</p>
        </div>

        <div class="urgency-box">
          <h3>WHAT OTHERS NOTICE.</h3>
          <p>[YOUR CONTENT GOES HERE.]</p>
        </div>

      </div>

    </div>
  </section>


  <!-- 04 / PARK THE PLAN -->
  <section class="urgency-section urgency-purple">
    <div class="urgency-inner">

      <p class="urgency-number">04 / PARK THE PLAN</p>

      <h2>
        WRITE IT DOWN.<br>
        LET IT SIT.
      </h2>

      <div class="urgency-copy">
        <p>[YOUR CONTENT GOES HERE.]</p>
      </div>

      <div class="urgency-grid">

        <div class="urgency-box">
          <h3>THE IDEA.</h3>
          <p>[YOUR CONTENT GOES HERE.]</p>
        </div>

        <div class="urgency-box">
          <h3>THE COST & COMMITMENT.</h3>
          <p>[YOUR CONTENT GOES HERE.]</p>
        </div>

        <div class="urgency-box">
          <h3>WHAT HAPPENS IF I WAIT?</h3>
          <p>[YOUR CONTENT GOES HERE.]</p>
        </div>

        <div class="urgency-box">
          <h3>WHEN I'LL REVISIT IT.</h3>
          <p>[YOUR CONTENT GOES HERE.]</p>
        </div>

      </div>

    </div>
  </section>


  <!-- 05 / ANOTHER PERSPECTIVE -->
  <section class="urgency-section urgency-black">
    <div class="urgency-inner">

      <p class="urgency-number">05 / ANOTHER PERSPECTIVE</p>

      <h2>
        RUN IT<br>
        BY SOMEONE.
      </h2>

      <div class="urgency-copy">
        <p>[YOUR CONTENT GOES HERE.]</p>
      </div>

      <div class="urgency-callout">
        <p>[YOUR REALITY-CHECK OR CARE-TEAM SCRIPT GOES HERE.]</p>
      </div>

    </div>
  </section>


  <!-- 06 / YOUR NEXT MOVE -->
  <section class="urgency-section urgency-pink">
    <div class="urgency-inner">

      <p class="urgency-number">06 / YOUR NEXT MOVE</p>

      <h2>
        CHOOSE THE<br>
        NEXT STEP.<br>
        NOT ALL OF THEM.
      </h2>

      <div class="urgency-copy">
        <p>[YOUR CONTENT GOES HERE.]</p>
      </div>

      <div class="urgency-callout">
        <p>[YOUR CLOSING PROMPT GOES HERE.]</p>
      </div>

    </div>
  </section>

</main>