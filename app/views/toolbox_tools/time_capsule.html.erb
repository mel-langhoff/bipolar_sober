<% content_for :title, "Time Capsule | Bipolar Sober" %>

<main class="capsule-page">

  <!-- HERO -->
  <section class="capsule-hero">

    <picture class="capsule-background" aria-hidden="true">
      <source
        media="(min-width: 768px)"
        srcset="<%= asset_path('toolbox_time_capsule_desktop.png') %>"
      >
      <%= image_tag "toolbox_time_capsule_mobile.png",
          alt: "",
          loading: "eager" %>
    </picture>

    <div class="capsule-hero-content">

      <p class="capsule-eyebrow">
        BIPOLAR SOBER / TOOLBOX / TIME CAPSULE
      </p>

      <h1>
        <span>OPEN WHEN</span>
        <span>YOUR BRAIN</span>
        <span>FORGETS.</span>
      </h1>

      <p class="capsule-intro">
        [YOUR INTRO GOES HERE.]
      </p>

    </div>
  </section>


  <!-- 01 / A NOTE TO YOURSELF -->
  <section class="capsule-section capsule-pink">
    <div class="capsule-inner">

      <p class="capsule-number">01 / A NOTE TO YOURSELF</p>

      <h2>
        DEAR<br>
        FUTURE ME.
      </h2>

      <div class="capsule-copy">
        <p>[YOUR CONTENT GOES HERE.]</p>
      </div>

      <div class="capsule-callout">
        <p>[YOUR LETTER OR WRITING PROMPT GOES HERE.]</p>
      </div>

    </div>
  </section>


  <!-- 02 / WHAT MATTERS -->
  <section class="capsule-section capsule-black">
    <div class="capsule-inner">

      <p class="capsule-number">02 / WHAT MATTERS</p>

      <h2>
        HERE'S WHAT<br>
        I WANT TO<br>
        REMEMBER.
      </h2>

      <div class="capsule-copy">
        <p>[YOUR CONTENT GOES HERE.]</p>
      </div>

      <div class="capsule-grid">

        <div class="capsule-box">
          <h3>WHAT I CARE ABOUT.</h3>
          <p>[YOUR CONTENT GOES HERE.]</p>
        </div>

        <div class="capsule-box">
          <h3>WHAT I WANT TO PROTECT.</h3>
          <p>[YOUR CONTENT GOES HERE.]</p>
        </div>

        <div class="capsule-box">
          <h3>WHAT I'M WORKING TOWARD.</h3>
          <p>[YOUR CONTENT GOES HERE.]</p>
        </div>

        <div class="capsule-box">
          <h3>WHAT MAKES LIFE FEEL LIKE MINE.</h3>
          <p>[YOUR CONTENT GOES HERE.]</p>
        </div>

      </div>

    </div>
  </section>


  <!-- 03 / PROOF -->
  <section class="capsule-section capsule-yellow">
    <div class="capsule-inner">

      <p class="capsule-number">03 / PROOF</p>

      <h2>
        YOU'VE BEEN<br>
        THROUGH SOME<br>
        SHIT.
      </h2>

      <div class="capsule-copy">
        <p>[YOUR CONTENT GOES HERE.]</p>
      </div>

      <div class="capsule-grid">

        <div class="capsule-box">
          <h3>WHAT I'VE SURVIVED.</h3>
          <p>[YOUR CONTENT GOES HERE.]</p>
        </div>

        <div class="capsule-box">
          <h3>WHAT I'M PROUD OF.</h3>
          <p>[YOUR CONTENT GOES HERE.]</p>
        </div>

      </div>

      <div class="capsule-callout">
        <p>[YOUR REMINDER GOES HERE.]</p>
      </div>

    </div>
  </section>


  <!-- 04 / DIFFERENT DAYS -->
  <section class="capsule-section capsule-purple">
    <div class="capsule-inner">

      <p class="capsule-number">04 / DIFFERENT DAYS</p>

      <h2>
        LEAVE A NOTE<br>
        FOR THAT<br>
        VERSION OF YOU.
      </h2>

      <div class="capsule-copy">
        <p>[YOUR CONTENT GOES HERE.]</p>
      </div>

      <div class="capsule-grid">

        <div class="capsule-box">
          <h3>WHEN EVERYTHING FEELS POINTLESS.</h3>
          <p>[YOUR CONTENT GOES HERE.]</p>
        </div>

        <div class="capsule-box">
          <h3>WHEN EVERYTHING FEELS POSSIBLE.</h3>
          <p>[YOUR CONTENT GOES HERE.]</p>
        </div>

        <div class="capsule-box">
          <h3>WHEN I WANT TO ESCAPE.</h3>
          <p>[YOUR CONTENT GOES HERE.]</p>
        </div>

        <div class="capsule-box">
          <h3>WHEN I FORGET MY PROGRESS.</h3>
          <p>[YOUR CONTENT GOES HERE.]</p>
        </div>

      </div>

    </div>
  </section>


  <!-- 05 / THE KEEPSAKES -->
  <section class="capsule-section capsule-black">
    <div class="capsule-inner">

      <p class="capsule-number">05 / THE KEEPSAKES</p>

      <h2>
        PUT SOMETHING<br>
        REAL IN HERE.
      </h2>

      <div class="capsule-copy">
        <p>[YOUR CONTENT GOES HERE.]</p>
      </div>

      <div class="capsule-grid">

        <div class="capsule-box">
          <h3>PHOTOS & OBJECTS.</h3>
          <p>[YOUR CONTENT GOES HERE.]</p>
        </div>

        <div class="capsule-box">
          <h3>WORDS WORTH KEEPING.</h3>
          <p>[YOUR CONTENT GOES HERE.]</p>
        </div>

      </div>

    </div>
  </section>


  <!-- 06 / KEEP ADDING -->
  <section class="capsule-section capsule-pink">
    <div class="capsule-inner">

      <p class="capsule-number">06 / KEEP ADDING</p>

      <h2>
        YOU'RE STILL<br>
        WRITING<br>
        THIS THING.
      </h2>

      <div class="capsule-copy">
        <p>[YOUR CONTENT GOES HERE.]</p>
      </div>

      <div class="capsule-callout">
        <p>[YOUR CLOSING PROMPT GOES HERE.]</p>
      </div>

    </div>
  </section>

</main>