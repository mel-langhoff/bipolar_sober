<% content_for :title, "Press Pause | Bipolar Sober" %>

<main class="pause-page">

  <!-- HERO -->
  <section class="pause-hero">

    <picture class="pause-background" aria-hidden="true">
      <source
        media="(min-width: 768px)"
        srcset="<%= asset_path('toolbox_press_pause_desktop.png') %>"
      >
      <%= image_tag "toolbox_press_pause_mobile.png",
          alt: "",
          loading: "eager" %>
    </picture>

    <div class="pause-hero-content">

      <p class="pause-eyebrow">
        BIPOLAR SOBER / TOOLBOX / PRESS PAUSE
      </p>

      <h1>
        <span>PRESS</span>
        <span>PAUSE.</span>
      </h1>

      <p class="pause-intro">
        [YOUR INTRO GOES HERE.]
      </p>

    </div>
  </section>


  <!-- 01 / THE IMPULSE -->
  <section class="pause-section pause-pink">
    <div class="pause-inner">

      <p class="pause-number">01 / THE IMPULSE</p>

      <h2>
        WHAT ARE YOU<br>
        ABOUT TO DO?
      </h2>

      <div class="pause-copy">
        <p>[YOUR CONTENT GOES HERE.]</p>
      </div>

      <div class="pause-callout">
        <p>[YOUR QUESTION OR PROMPT GOES HERE.]</p>
      </div>

    </div>
  </section>


  <!-- 02 / MAKE SOME SPACE -->
  <section class="pause-section pause-black">
    <div class="pause-inner">

      <p class="pause-number">02 / MAKE SOME SPACE</p>

      <h2>
        HOLD THE<br>
        FUCK ON.
      </h2>

      <div class="pause-copy">
        <p>[YOUR CONTENT GOES HERE.]</p>
      </div>

      <div class="pause-grid">

        <div class="pause-box">
          <h3>STEP AWAY.</h3>
          <p>[YOUR CONTENT GOES HERE.]</p>
        </div>

        <div class="pause-box">
          <h3>PUT IT DOWN.</h3>
          <p>[YOUR CONTENT GOES HERE.]</p>
        </div>

        <div class="pause-box">
          <h3>GIVE IT TIME.</h3>
          <p>[YOUR CONTENT GOES HERE.]</p>
        </div>

      </div>

    </div>
  </section>


  <!-- 03 / CHECK THE NEED -->
  <section class="pause-section pause-yellow">
    <div class="pause-inner">

      <p class="pause-number">03 / CHECK THE NEED</p>

      <h2>
        WHAT DO YOU<br>
        WANT THIS<br>
        TO DO FOR YOU?
      </h2>

      <div class="pause-copy">
        <p>[YOUR CONTENT GOES HERE.]</p>
      </div>

      <div class="pause-callout">
        <p>[YOUR REFLECTION PROMPT GOES HERE.]</p>
      </div>

    </div>
  </section>


  <!-- 04 / PARK IT HERE -->
  <section class="pause-section pause-purple">
    <div class="pause-inner">

      <p class="pause-number">04 / PARK IT HERE</p>

      <h2>
        IT CAN LIVE<br>
        IN A DRAFT.
      </h2>

      <div class="pause-copy">
        <p>[YOUR CONTENT GOES HERE.]</p>
      </div>

      <div class="pause-grid">

        <div class="pause-box">
          <h3>THE MESSAGE.</h3>
          <p>[YOUR CONTENT GOES HERE.]</p>
        </div>

        <div class="pause-box">
          <h3>THE PURCHASE.</h3>
          <p>[YOUR CONTENT GOES HERE.]</p>
        </div>

        <div class="pause-box">
          <h3>THE BIG DECISION.</h3>
          <p>[YOUR CONTENT GOES HERE.]</p>
        </div>

      </div>

    </div>
  </section>


  <!-- 05 / ANOTHER OPTION -->
  <section class="pause-section pause-black">
    <div class="pause-inner">

      <p class="pause-number">05 / ANOTHER OPTION</p>

      <h2>
        WHAT ELSE<br>
        COULD YOU DO?
      </h2>

      <div class="pause-copy">
        <p>[YOUR CONTENT GOES HERE.]</p>
      </div>

      <div class="pause-callout">
        <p>[YOUR ALTERNATIVES OR SUPPORT SCRIPT GOES HERE.]</p>
      </div>

    </div>
  </section>


  <!-- 06 / REVISIT -->
  <section class="pause-section pause-pink">
    <div class="pause-inner">

      <p class="pause-number">06 / REVISIT</p>

      <h2>
        DECIDE WHEN<br>
        YOU'VE HAD<br>
        SOME SPACE.
      </h2>

      <div class="pause-copy">
        <p>[YOUR CONTENT GOES HERE.]</p>
      </div>

      <div class="pause-callout">
        <p>[YOUR PLAN FOR REVISITING THE DECISION GOES HERE.]</p>
      </div>

    </div>
  </section>

</main>