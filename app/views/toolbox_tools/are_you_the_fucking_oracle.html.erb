<% content_for :title, "Are You the Fucking Oracle? | Bipolar Sober" %>

<main class="oracle-page">

  <!-- HERO -->
  <section class="oracle-hero">

    <picture class="oracle-background" aria-hidden="true">
      <source
        media="(min-width: 768px)"
        srcset="<%= asset_path('toolbox_are_you_the_fucking_oracle_desktop.png') %>"
      >
      <%= image_tag "toolbox_are_you_the_fucking_oracle_mobile.png",
          alt: "",
          loading: "eager" %>
    </picture>

    <div class="oracle-hero-content">

