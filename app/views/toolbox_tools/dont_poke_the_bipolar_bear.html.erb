      <%= image_tag "toolbox_dont_poke_the_bipolar_bear_mobile.png",
          alt: "",
          loading: "eager" %>
    </picture>

    <div class="bear-hero-content">

      <p class="bear-eyebrow">
        BIPOLAR SOBER / TOOLBOX / BIPOLAR RAGE
