<% content_for :title, "Don't Poke the Bipolar Bear | Bipolar Sober" %>

<main class="bear-page">

  <!-- HERO -->
  <section class="bear-hero">

    <picture class="bear-background" aria-hidden="true">
      <source
        media="(min-width: 768px)"
        srcset="<%= asset_path('toolbox_dont_poke_the_bipolar_bear_desktop.png') %>"
