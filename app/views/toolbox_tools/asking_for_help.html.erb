<% content_for :title, "Asking for Help | Bipolar Sober" %>

<main class="help-page">

  <!-- HERO -->
  <section class="help-hero">

    <picture class="help-background" aria-hidden="true">
      <source
        media="(min-width: 768px)"
        srcset="<%= asset_path('toolbox_asking_for_help_desktop.png') %>"
      >
      <%= image_tag "toolbox_asking_for_help_mobile.png",
          alt: "",
          loading: "eager" %>
    </picture>

    <div class="help-hero-content">

      <p class="help-eyebrow">
        BIPOLAR SOBER / TOOLBOX / ASKING FOR HELP
      </p>

      <h1>
        <span>YOU NEED</span>
        <span>A HAND.</span>
        <span>NOT A DEFENSE</span>
        <span>ATTORNEY.</span>
      </h1>

      <p class="help-intro">
        [YOUR INTRO GOES HERE.]
      </p>

    </div>
  </section>


