<% content_for :title, "Let Creativity In | Bipolar Sober" %>

<main class="creative-page">

  <!-- HERO -->
  <section class="creative-hero">

    <picture class="creative-background" aria-hidden="true">
      <source
        media="(min-width: 768px)"
        srcset="<%= asset_path('toolbox_let_creativity_in_desktop.png') %>"
      >
      <%= image_tag "toolbox_let_creativity_in_mobile.png",
          alt: "",
          loading: "eager" %>
    </picture>

    <div class="creative-hero-content">

      <p class="creative-eyebrow">
        BIPOLAR SOBER / TOOLBOX / LET CREATIVITY IN
      </p>

      <h1>
        <span>LET</span>
        <span>CREATIVITY</span>
        <span>IN.</span>
      </h1>

      <p class="creative-tagline">
        PERFECTION CAN FUCK OFF.
      </p>

      <p class="creative-intro">
        [YOUR INTRO GOES HERE.]
      </p>

    </div>
  </section>


