<% content_for :title, "When You Don't Trust Your Mood | Bipolar Sober" %>

<main class="mood-check-page">

  <!-- HERO -->
  <section class="mood-check-hero">

    <picture class="mood-check-background" aria-hidden="true">
      <source
        media="(min-width: 768px)"
        srcset="<%= asset_path('toolbox_when_you_dont_trust_your_mood_desktop.png') %>"
      >
      <%= image_tag "toolbox_when_you_dont_trust_your_mood_mobile.png",
          alt: "",
          loading: "eager" %>
    </picture>

    <div class="mood-check-hero-content">

      <p class="mood-check-eyebrow">
        BIPOLAR SOBER / TOOLBOX / WHEN YOU DON'T TRUST YOUR MOOD
      </p>

      <h1>
        <span>MOOD CHECK</span>
        <span>BEFORE</span>
        <span>YOU WRECK.</span>
      </h1>

      <p class="mood-check-intro">
        [YOUR INTRO GOES HERE.]
      </p>

    </div>
  </section>


  <!-- 01 / CHECK IN -->
  <section class="mood-check-section mood-check-pink">
    <div class="mood-check-inner">

      <p class="mood-check-number">01 / CHECK IN</p>

      <h2>
        WHAT FEELS<br>
        DIFFERENT?
      </h2>

      <div class="mood-check-copy">
        <p>[YOUR CONTENT GOES HERE.]</p>
      </div>

      <div class="mood-check-callout">
        <p>[YOUR QUESTION OR PROMPT GOES HERE.]</p>
      </div>

    </div>
  </section>


  <!-- 02 / LOOK FOR CHANGES -->
  <section class="mood-check-section mood-check-black">
    <div class="mood-check-inner">

      <p class="mood-check-number">02 / LOOK FOR CHANGES</p>

      <h2>
        CHECK THE<br>
        PATTERNS.
      </h2>

      <div class="mood-check-copy">
        <p>[YOUR CONTENT GOES HERE.]</p>
      </div>

      <div class="mood-check-grid">

        <div class="mood-check-box">
          <h3>SLEEP.</h3>
          <p>[YOUR CONTENT GOES HERE.]</p>
        </div>

        <div class="mood-check-box">
          <h3>ENERGY & PACE.</h3>
          <p>[YOUR CONTENT GOES HERE.]</p>
        </div>

        <div class="mood-check-box">
          <h3>IRRITABILITY.</h3>
          <p>[YOUR CONTENT GOES HERE.]</p>
        </div>

        <div class="mood-check-box">
          <h3>SPENDING & IMPULSES.</h3>
          <p>[YOUR CONTENT GOES HERE.]</p>
        </div>

        <div class="mood-check-box">
          <h3>CONNECTION & WITHDRAWAL.</h3>
          <p>[YOUR CONTENT GOES HERE.]</p>
        </div>

        <div class="mood-check-box">
          <h3>THOUGHTS & PERCEPTION.</h3>
          <p>[YOUR CONTENT GOES HERE.]</p>
        </div>

      </div>

    </div>
  </section>


  <!-- 03 / YOUR BASELINE -->
  <section class="mood-check-section mood-check-yellow">
    <div class="mood-check-inner">

      <p class="mood-check-number">03 / YOUR BASELINE</p>

      <h2>
        NORMAL<br>
        FOR YOU.
      </h2>

      <div class="mood-check-copy">
        <p>[YOUR CONTENT GOES HERE.]</p>
      </div>

      <div class="mood-check-callout">
        <p>[YOUR BASELINE REMINDER GOES HERE.]</p>
      </div>

    </div>
  </section>


  <!-- 04 / ANOTHER PERSPECTIVE -->
  <section class="mood-check-section mood-check-purple">
    <div class="mood-check-inner">

      <p class="mood-check-number">04 / ANOTHER PERSPECTIVE</p>

      <h2>
        BORROW A<br>
        SECOND OPINION.
      </h2>

      <div class="mood-check-copy">
        <p>[YOUR CONTENT GOES HERE.]</p>
      </div>

      <div class="mood-check-grid">

        <div class="mood-check-box">
          <h3>WHO DO YOU TRUST?</h3>
          <p>[YOUR CONTENT GOES HERE.]</p>
        </div>

        <div class="mood-check-box">
          <h3>WHAT CAN YOU ASK?</h3>
          <p>[YOUR SCRIPT OR PROMPT GOES HERE.]</p>
        </div>

      </div>

    </div>
  </section>


  <!-- 05 / PRESS PAUSE -->
  <section class="mood-check-section mood-check-black">
    <div class="mood-check-inner">

      <p class="mood-check-number">05 / PRESS PAUSE</p>

      <h2>
        WHAT CAN<br>
        FUCKING WAIT?
      </h2>

      <div class="mood-check-copy">
        <p>[YOUR CONTENT GOES HERE.]</p>
      </div>

      <div class="mood-check-callout">
        <p>[YOUR DECISION-PAUSE PLAN GOES HERE.]</p>
      </div>

    </div>
  </section>


  <!-- 06 / YOUR SUPPORT PLAN -->
  <section class="mood-check-section mood-check-pink">
    <div class="mood-check-inner">

      <p class="mood-check-number">06 / YOUR SUPPORT PLAN</p>

      <h2>
        KNOW YOUR<br>
        NEXT MOVE.
      </h2>

      <div class="mood-check-copy">
        <p>[YOUR CONTENT GOES HERE.]</p>
      </div>

      <div class="mood-check-grid">

        <div class="mood-check-box">
          <h3>MY WARNING SIGNS.</h3>
          <p>[YOUR CONTENT GOES HERE.]</p>
        </div>

        <div class="mood-check-box">
          <h3>MY SUPPORT PEOPLE.</h3>
          <p>[YOUR CONTENT GOES HERE.]</p>
        </div>

        <div class="mood-check-box">
          <h3>WHEN TO CONTACT MY docs.</h3>
          <p>[YOUR CONTENT GOES HERE.]</p>
        </div>

        <div class="mood-check-box">
          <h3>WHEN I NEED URGENT HELP.</h3>
          <p>[YOUR CONTENT GOES HERE.]</p>
        </div>

      </div>

    </div>
  </section>

</main>