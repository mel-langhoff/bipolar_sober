<% content_for :title, "Quotes | Bipolar Sober" %>

<main class="perspectives-quotes-page">

  <!-- HERO -->
  <section class="perspectives-quotes-hero">
    <div class="perspectives-quotes-hero-content">
      <p class="perspectives-quotes-eyebrow">BIPOLAR SOBER / PERSPECTIVES / QUOTES</p>
      <h1><span>WORDS</span><span>WORTH</span><span>KEEPING.</span></h1>
      <p class="perspectives-quotes-intro">SHIT YOU UNDERLINED.<br>SHIT YOU WROTE DOWN.<br>SHIT THAT MADE YOU LOOK TWICE.</p>
