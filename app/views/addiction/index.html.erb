<% content_for :title, "Addiction | Bipolar Sober" %>

<main class="addiction-page">

  <section class="addiction-hero">
    <div class="addiction-hero-content">

      <p class="addiction-eyebrow">
        BIPOLAR SOBER / ADDICTION
      </p>

      <h1>
        <span>ON</span>
        <span>ADDICTION.</span>
      </h1>

      <p class="addiction-intro">
        THE DRINK ISN'T<br>
        THE WHOLE FUCKING STORY.
      </p>

    </div>
  </section>


  <section class="addiction-topics" id="addiction-topics">

    <div class="addiction-topics-heading">

      <p>01 / ADDICTION</p>

      <h2>
        WHAT'S<br>
        UNDERNEATH?
      </h2>

      <p class="addiction-topics-subtitle">
        Drinking was the behavior. Now let's look at what's underneath.
      </p>

    </div>


    <div class="addiction-grid">

      <!-- PERSPECTIVES -->

      <%= link_to addiction_perspectives_path,
          class: "addiction-card addiction-card-black" do %>

        <p class="addiction-card-number">01</p>

        <h3>
          PERSPECTIVES
        </h3>

        <p class="addiction-card-description">
          Different ways of looking at addiction, craving, suffering,
          recovery, and why we keep reaching for the thing that's hurting us.
        </p>

        <span>EXPLORE →</span>

      <% end %>


      <!-- BIPOLAR & ADDICTION -->

      <%= link_to addiction_bipolar_path,
          class: "addiction-card addiction-card-purple" do %>

        <p class="addiction-card-number">02</p>

        <h3>
          BIPOLAR &amp;<br>
          ADDICTION
        </h3>

        <p class="addiction-card-description">
          Mania. Depression. Mixed episodes.
          How drinking and substance use get tangled up with bipolar
          disorder, including when your mood is stable.
        </p>

        <span>UNTANGLE IT →</span>

      <% end %>


      <!-- WHAT AM I ESCAPING? -->

      <%= link_to addiction_what_am_i_escaping_path,
          class: "addiction-card addiction-card-yellow" do %>

        <p class="addiction-card-number">03</p>

        <h3>
          WHAT AM I<br>
          ESCAPING?
        </h3>

        <p class="addiction-card-description">
          What's behind the urge to disappear? Feelings, memories,
          boredom, pain, fear, loneliness — or just being inside your own head.
        </p>

        <span>GO THERE →</span>

      <% end %>


      <!-- TRIGGERS -->

      <%= link_to addiction_triggers_path,
          class: "addiction-card addiction-card-pink" do %>

        <p class="addiction-card-number">04</p>

        <h3>
          TRIGGERS
        </h3>

        <p class="addiction-card-description">
          People. Places. Feelings. Memories. Situations.
          Figure out what flips the switch before the switch gets flipped.
        </p>

        <span>IDENTIFY THEM →</span>

      <% end %>


      <!-- CRAVINGS -->

      <%= link_to addiction_cravings_path,
          class: "addiction-card addiction-card-black" do %>

        <p class="addiction-card-number">05</p>

        <h3>
          CRAVINGS
        </h3>

        <p class="addiction-card-description">
          The urge. The bargaining. The selective fucking memory.
          Understanding what you want, what you expect it to give you,
          and how the craving builds.
        </p>

        <span>UNDERSTAND THE URGE →</span>

      <% end %>


      <!-- IMPULSIVITY -->

      <%= link_to addiction_impulsivity_path,
          class: "addiction-card addiction-card-purple" do %>

        <p class="addiction-card-number">06</p>

        <h3>
          IMPULSIVITY
        </h3>

        <p class="addiction-card-description">
          Want it. Do it. Regret it. Repeat.
          Breaking down the space between an impulse and an action.
        </p>

        <span>SLOW IT DOWN →</span>

      <% end %>


      <!-- SHAME & ACCOUNTABILITY -->

      <%= link_to addiction_shame_path,
          class: "addiction-card addiction-card-yellow" do %>

        <p class="addiction-card-number">07</p>

        <h3>
          SHAME &amp;<br>
          ACCOUNTABILITY
        </h3>

        <p class="addiction-card-description">
          Regret. Secrecy. The shit you wish you could undo.
          Taking responsibility and making repairs
          without turning your past into your entire identity.
        </p>

        <span>FACE IT WITH COMPASSION →</span>

      <% end %>

    </div>

  </section>

</main>