<% content_for :title, "Shinto & Addiction | Bipolar Sober" %>

<style>
  /* ==========================================
     SHINTO & ADDICTION
     ========================================== */

  .sha-page {
    --sha-black: #080808;
    --sha-pink: #ff1493;
    --sha-yellow: #eaff00;
    --sha-purple: #8a00ff;
    --sha-white: #ffffff;

    margin: 0;
    background: var(--sha-black);
    color: var(--sha-white);
    font-family: Arial, Helvetica, sans-serif;
  }

  .sha-page,
  .sha-page *,
  .sha-page *::before,
  .sha-page *::after {
    box-sizing: border-box;
  }

  .sha-page h1,
  .sha-page h2,
  .sha-page h3,
  .sha-page p {
    margin: 0;
  }

  /* HERO */

  .sha-page .sha-hero {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    min-height: 800px;
    min-height: max(800px, 100svh);
    padding: 130px 5vw 90px;
    background: var(--sha-black);
  }

  .sha-page .sha-picture {
    position: absolute;
    inset: 0;
    z-index: -2;
    display: block;
    width: 100%;
    height: 100%;
  }

  .sha-page .sha-picture img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: right center;
  }

  .sha-page .sha-hero::after {
    position: absolute;
    inset: 0;
    z-index: -1;
    content: "";
    pointer-events: none;
    background: linear-gradient(
      90deg,
      rgba(8, 8, 8, 0.35),
      transparent 75%
    );
  }

  .sha-page .sha-hero-content {
    width: 58%;
    max-width: 850px;
  }

  .sha-page .sha-eyebrow {
    margin-bottom: 30px;
    color: var(--sha-yellow);
    font-size: 12px;
    font-weight: 900;
    line-height: 1.7;
    letter-spacing: 0.1em;
  }

  .sha-page .sha-hero h1 {
    font-size: clamp(62px, 7vw, 130px);
    font-weight: 900;
    line-height: 0.94;
    letter-spacing: -0.06em;
    text-transform: uppercase;
  }

  .sha-page .sha-hero h1 span {
    display: block;
  }

  .sha-page .sha-intro {
    max-width: 500px;
    margin-top: 32px;
    font-size: clamp(14px, 1.3vw, 19px);
    font-weight: 800;
    line-height: 1.7;
  }

  /* CONTENT */

  .sha-page .sha-section {
    padding: 85px 5vw;
  }

  .sha-page .sha-inner {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    align-items: start;
    gap: clamp(35px, 5vw, 90px);
    max-width: 1400px;
    margin: 0 auto;
  }

  .sha-page .sha-heading,
  .sha-page .sha-copy {
    min-width: 0;
  }

  .sha-page .sha-number {
    margin-bottom: 25px;
    font-size: 12px;
    font-weight: 900;
    line-height: 1.6;
    letter-spacing: 0.08em;
  }

  .sha-page .sha-heading h2 {
    font-size: clamp(38px, 4.5vw, 80px);
    font-weight: 900;
    line-height: 0.98;
    letter-spacing: -0.05em;
    overflow-wrap: break-word;
  }

  .sha-page .sha-copy > p {
    margin-bottom: 23px;
    font-size: 18px;
    line-height: 1.8;
  }

  .sha-page .sha-copy > p:last-child {
    margin-bottom: 0;
  }

  .sha-page .sha-copy > .sha-lead {
    font-size: clamp(21px, 2vw, 27px);
    font-weight: 800;
    line-height: 1.5;
    letter-spacing: -0.025em;
  }

  /* COLORS */

  .sha-page .sha-black {
    background: var(--sha-black);
    color: var(--sha-white);
  }

  .sha-page .sha-pink {
    background: var(--sha-pink);
    color: var(--sha-black);
  }

  .sha-page .sha-yellow {
    background: var(--sha-yellow);
    color: var(--sha-black);
  }

  .sha-page .sha-purple {
    background: var(--sha-purple);
    color: var(--sha-white);
  }

  .sha-page .sha-black .sha-number,
  .sha-page .sha-purple .sha-number {
    color: var(--sha-yellow);
  }

  /* CARDS */

  .sha-page .sha-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin: 30px 0;
  }

  .sha-page .sha-card {
    min-width: 0;
    padding: 24px;
    border: 2px solid currentColor;
  }

  .sha-page .sha-card span {
    display: block;
    margin-bottom: 17px;
    font-size: 11px;
    font-weight: 900;
    line-height: 1.5;
    letter-spacing: 0.08em;
  }

  .sha-page .sha-card h3 {
    margin-bottom: 15px;
    font-size: clamp(22px, 2vw, 29px);
    font-weight: 900;
    line-height: 1.1;
    letter-spacing: -0.035em;
    overflow-wrap: break-word;
  }

  .sha-page .sha-card p {
    font-size: 16px;
    line-height: 1.75;
  }

  /* CALLOUTS */

  .sha-page .sha-callout {
    margin: 30px 0;
    padding: 26px;
    border: 3px solid currentColor;
    font-size: clamp(22px, 2.4vw, 34px);
    font-weight: 900;
    line-height: 1.25;
    letter-spacing: -0.03em;
    overflow-wrap: break-word;
  }

  .sha-page .sha-black .sha-callout,
  .sha-page .sha-purple .sha-callout {
    color: var(--sha-yellow);
  }

  .sha-page .sha-stack {
    display: grid;
    gap: 12px;
    margin: 30px 0;
  }

  .sha-page .sha-stack p {
    padding: 18px 20px;
    border: 2px solid currentColor;
    font-size: 16px;
    font-weight: 800;
    line-height: 1.5;
  }

  /* ENDING */

  .sha-page .sha-ending {
    padding: 90px 5vw;
    background: var(--sha-black);
    color: var(--sha-white);
  }

  .sha-page .sha-ending-inner {
    max-width: 1400px;
    margin: 0 auto;
  }

  .sha-page .sha-ending-label {
    margin-bottom: 28px;
    color: var(--sha-yellow);
    font-size: 12px;
    font-weight: 900;
    line-height: 1.7;
    letter-spacing: 0.08em;
  }

  .sha-page .sha-ending h2 {
    margin-bottom: 30px;
    font-size: clamp(50px, 8vw, 125px);
    font-weight: 900;
    line-height: 0.94;
    letter-spacing: -0.06em;
  }

  .sha-page .sha-ending-copy {
    max-width: 680px;
    margin-bottom: 32px;
    font-size: 18px;
    line-height: 1.8;
  }

  .sha-page .sha-back {
    display: inline-block;
    max-width: 100%;
    padding: 17px 22px;
    border: 2px solid var(--sha-yellow);
    color: var(--sha-yellow);
    background: transparent;
    font-size: 13px;
    font-weight: 900;
    line-height: 1.5;
    text-decoration: none;
    transition:
      background-color 160ms ease,
      color 160ms ease;
  }

  .sha-page .sha-back:hover {
    background: var(--sha-yellow);
    color: var(--sha-black);
  }

  .sha-page .sha-back:focus-visible {
    outline: 3px solid var(--sha-white);
    outline-offset: 5px;
  }

  /* TABLET */

  @media (max-width: 1000px) {
    .sha-page .sha-inner {
      grid-template-columns: minmax(0, 1fr);
      max-width: 850px;
      gap: 35px;
    }

    .sha-page .sha-heading h2 {
      font-size: clamp(45px, 7vw, 75px);
    }
  }

  /* MOBILE */

  @media (max-width: 767px) {
    .sha-page .sha-hero {
      align-items: flex-start;
      min-height: 1000px;
      min-height: max(1000px, 125svh);
      padding: 110px 22px 60px;
    }

    .sha-page .sha-picture img {
      object-position: center bottom;
    }

    .sha-page .sha-hero::after {
      background: linear-gradient(
        180deg,
        rgba(8, 8, 8, 0.15),
        transparent 70%
      );
    }

    .sha-page .sha-hero-content {
      width: 100%;
      max-width: 550px;
    }

    .sha-page .sha-eyebrow {
      margin-bottom: 27px;
      font-size: 10px;
      letter-spacing: 0.06em;
    }

    .sha-page .sha-hero h1 {
      font-size: clamp(44px, 11vw, 82px);
    }

    .sha-page .sha-intro {
      margin-top: 27px;
      font-size: 13px;
    }

    .sha-page .sha-section {
      padding: 60px 22px;
    }

    .sha-page .sha-heading h2 {
      font-size: clamp(38px, 10vw, 65px);
    }

    .sha-page .sha-copy > p {
      font-size: 17px;
    }

    .sha-page .sha-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .sha-page .sha-card h3 {
      font-size: 26px;
    }

    .sha-page .sha-callout {
      padding: 23px;
      font-size: 25px;
    }

    .sha-page .sha-ending {
      padding: 70px 22px;
    }

    .sha-page .sha-ending h2 {
      font-size: clamp(45px, 11vw, 80px);
    }

    .sha-page .sha-ending-copy {
      font-size: 17px;
    }
  }
</style>



<main class="sha-page">

  <!-- HERO -->
  <section class="sha-hero">

    <picture class="sha-picture">
      <source
        media="(max-width: 767px)"
        srcset="<%= asset_path('addiction_shinto_mobile.png') %>">

      <%= image_tag "addiction_shinto_desktop.png",
          alt: "",
          fetchpriority: "high" %>
    </picture>

    <div class="sha-hero-content">

      <p class="sha-eyebrow">
        BIPOLAR SOBER / ADDICTION / PERSPECTIVES / SHINTO
      </p>

      <h1>
        <span>ADDICTION</span>
        <span>THROUGH A</span>
        <span>SHINTO LENS.</span>
      </h1>

      <p class="sha-intro">
        SINCERITY. RELATIONSHIP. RENEWAL.<br>
        WHAT DOES RETURNING TO YOUR LIFE LOOK LIKE?
      </p>

    </div>

  </section>


  <!-- 01 / THE PERSPECTIVE -->
  <section class="sha-section sha-black">
    <div class="sha-inner">

      <div class="sha-heading">
        <p class="sha-number">01 / A WAY OF LOOKING</p>

        <h2>
          LOOK AT<br>
          THE LIFE<br>
          AROUND IT.
        </h2>
      </div>

      <div class="sha-copy">

        <p class="sha-lead">
          Your actions affect more than just yourself.
        </p>

        <p>
          Shinto offers a perspective on addiction through
          sincerity, purification, harmony, relationships,
          and renewal. Although Shinto does not have a
          formal doctrine concerning addiction, its
          teachings encourage reflection on how your
          actions affect your connection with other
          people and the world around you.
        </p>

        <p>
          Kegare, traditionally associated with ritual
          impurity, can symbolically represent disruption,
          while harae and misogi offer images of
          purification and renewal. These concepts
          do not suggest that addiction or mental
          illness makes you spiritually impure.
          Instead, they provide a way to examine
          what has been disrupted and how harmony
          might be restored.
        </p>

        <div class="sha-callout">
          WHAT WAS DISRUPTED?<br>
          WHAT CAN BE RESTORED?
        </div>

      </div>

    </div>
  </section>


  <!-- 02 / FIRST DUI -->
  <section class="sha-section sha-pink">
    <div class="sha-inner">

      <div class="sha-heading">
        <p class="sha-number">02 / DISCONNECTION &amp; HARMONY</p>

        <h2>
          PAIN<br>
          CHANGES<br>
          EVERYTHING.
        </h2>
      </div>

      <div class="sha-copy">

        <p class="sha-lead">
          FIRST DUI / PHYSICAL SUFFERING &amp; DISRUPTION
        </p>

        <p>
          Severe sciatica pain disconnected you from
          the world by leaving you bedridden in a
          basement, unable to participate in ordinary
          life. You drank because alcohol relieved
          your physical suffering and allowed you
          to get out into the world again.
        </p>

        <p>
          However, your decision led to an accident
          that affected your family, the owner of
          the trailer you hit, and Banjo, who went
          missing for two days. You also faced
          legal consequences.
        </p>

        <div class="sha-grid">

          <div class="sha-card">
            <span>THE DISCONNECTION</span>
            <h3>PHYSICAL SUFFERING.</h3>
            <p>
              Your pain isolated you from the world,
              your independence, and your ordinary life.
              Alcohol offered temporary relief.
            </p>
          </div>

          <div class="sha-card">
            <span>THE DISRUPTION</span>
            <h3>REAL CONSEQUENCES.</h3>
            <p>
              Drinking and driving endangered others,
              disrupted relationships, and created
              consequences beyond your own suffering.
            </p>
          </div>

        </div>

        <p>
          Through a Shinto perspective, restoring
          harmony meant acknowledging the disruption
          you caused and fulfilling your court-ordered
          responsibilities. Your pain explained why
          you sought relief, but it did not erase
          the consequences of your actions.
        </p>

      </div>

    </div>
  </section>


  <!-- 03 / THIRD DUI -->
  <section class="sha-section sha-yellow">
    <div class="sha-inner">

      <div class="sha-heading">
        <p class="sha-number">03 / MAKOTO — SINCERITY</p>

        <h2>
          TELL<br>
          THE WHOLE<br>
          FUCKING STORY.
        </h2>
      </div>

      <div class="sha-copy">

        <p class="sha-lead">
          THIRD DUI / MANIA &amp; RESPONSIBILITY
        </p>

        <p>
          Your Third DUI illustrates how impaired
          judgment can disrupt your relationship
          with responsibility. Mania intensified
          your impulsivity and weakened your ability
          to control your decisions.
        </p>

        <p>
          When the interlock malfunctioned, you
          interpreted it as the disappearance of
          rules and an opportunity to do whatever
          you wanted. Your desire to drink took
          priority over the restrictions and
          responsibilities you wanted to escape.
        </p>

        <div class="sha-callout">
          A REASON<br>
          IS NOT<br>
          AN EXCUSE.
        </div>

        <p>
          Shinto's emphasis on makoto, or sincerity,
          encourages you to acknowledge both the
          influence of mania and your responsibility
          for what followed. You recognize that
          bipolar disorder affected your judgment,
          but you still take responsibility for
          your actions.
        </p>

        <p>
          You cannot undo the consequences of
          this DUI. For you, renewal begins with
          something straightforward: staying sober.
        </p>

      </div>

    </div>
  </section>


  <!-- 04 / RELATIONSHIPS -->
  <section class="sha-section sha-purple">
    <div class="sha-inner">

      <div class="sha-heading">
        <p class="sha-number">04 / RELATIONSHIP &amp; HARMONY</p>

        <h2>
          WORDS<br>
          HAVE<br>
          CONSEQUENCES.
        </h2>
      </div>

      <div class="sha-copy">

        <p class="sha-lead">
          PRESS SEND / SINCERITY &amp; BOUNDARIES
        </p>

        <p>
          In Press Send, intoxication affected the
          sincerity and responsibility of your
          communication. You sent rude messages
          at inappropriate hours, sometimes fishing
          for reassurance or a reaction instead
          of honestly expressing what you needed.
          Your behavior disrupted relationships
          and upset people you cared about.
        </p>

        <p>
          Through makoto, you can examine the
          difference between having genuine feelings
          and communicating them in harmful ways.
          Wanting reassurance, contact, and love
          did not justify hurting others or
          disregarding their boundaries.
        </p>

        <div class="sha-stack">
          <p>ACKNOWLEDGE WHAT YOU SAID.</p>
          <p>EXPRESS YOUR NEEDS HONESTLY.</p>
          <p>RESPECT THEIR BOUNDARIES.</p>
          <p>ACCEPT THEIR DECISIONS.</p>
        </div>

        <p>
          Restoring harmony involves acknowledging
          your words, communicating more honestly,
          and respecting another person's decision
          to maintain distance. An apology does
          not obligate someone to restore a
          relationship.
        </p>

      </div>

    </div>
  </section>


  <!-- 05 / PURIFICATION -->
  <section class="sha-section sha-black">
    <div class="sha-inner">

      <div class="sha-heading">
        <p class="sha-number">05 / PURIFICATION &amp; RENEWAL</p>

        <h2>
          CLEANSE.<br>
          BUT DON'T<br>
          ERASE.
        </h2>
      </div>

      <div class="sha-copy">

        <p class="sha-lead">
          Renewal does not mean pretending
          nothing happened.
        </p>

        <p>
          In Shinto, harae and misogi are
          purification practices associated
          with restoring ritual purity.
          Used symbolically in your recovery,
          purification can represent a
          commitment to living differently.
          It cannot undo an accident, reverse
          legal consequences, or take back
          hurtful words.
        </p>

        <p>
          A ritual may mark an intention,
          but practical actions give that
          intention meaning. Staying sober,
          fulfilling responsibilities,
          apologizing where appropriate,
          and respecting boundaries are
          ways of participating differently
          in the world around you.
        </p>

        <div class="sha-grid">

          <div class="sha-card">
            <span>SYMBOLIC RENEWAL</span>
            <h3>THE INTENTION.</h3>
            <p>
              Purification can represent
              your willingness to acknowledge
              disruption and begin again.
            </p>
          </div>

          <div class="sha-card">
            <span>PRACTICAL RENEWAL</span>
            <h3>THE ACTION.</h3>
            <p>
              Your behavior demonstrates
              change through sobriety,
              accountability, and respect
              for others.
            </p>
          </div>

        </div>

        <div class="sha-callout">
          YOU CAN BEGIN AGAIN.<br>
          YOU STILL HAVE TO<br>
          OWN WHAT HAPPENED.
        </div>

      </div>

    </div>
  </section>


  <!-- 06 / GRATITUDE -->
  <section class="sha-section sha-pink">
    <div class="sha-inner">

      <div class="sha-heading">
        <p class="sha-number">06 / GRATITUDE &amp; PARTICIPATION</p>

        <h2>
          NOTICE<br>
          WHAT STILL<br>
          MATTERS.
        </h2>
      </div>

      <div class="sha-copy">

        <p>
          Gratitude in Shinto encourages recognition
          of the relationships and circumstances
          that sustain life. Addiction can narrow
          your attention toward immediate desires
          and away from the people, places, and
          responsibilities around you.
        </p>

        <p>
          Gratitude does not eliminate addiction,
          physical pain, or bipolar disorder.
          It offers another way to recognize
          what exists beyond the immediate
          desire for relief.
        </p>

        <p>
          Caring for Banjo, maintaining relationships,
          participating in spiritual practices,
          and taking responsibility for your
          commitments can all reconnect you
          with the life around you.
        </p>

        <div class="sha-callout">
          WHAT MATTERS?<br>
          HOW DO YOU<br>
          CARE FOR IT?
        </div>

      </div>

    </div>
  </section>


  <!-- 07 / THE BIGGER PICTURE -->
  <section class="sha-section sha-yellow">
    <div class="sha-inner">

      <div class="sha-heading">
        <p class="sha-number">07 / THE BIGGER PICTURE</p>

        <h2>
          RESTORE<br>
          WHAT YOU<br>
          CAN.
        </h2>
      </div>

      <div class="sha-copy">

        <p class="sha-lead">
          Sincerity means facing what happened
          without rewriting the story.
        </p>

        <p>
          Your First DUI involved physical pain,
          isolation, and an attempt to reconnect
          with the world through alcohol.
          Your Third DUI involved mania,
          impulsivity, and a desire for freedom
          from restrictions. Press Send involved
          a need for connection expressed through
          harmful communication.
        </p>

        <p>
          Although these experiences differed,
          they affected people, relationships,
          responsibilities, and your own
          connection with the world.
        </p>

        <p>
          Shinto offers a way to understand
          recovery as restoring sincerity
          and harmony rather than attempting
          to erase the past. You cannot
          reverse every consequence or
          demand forgiveness, but you can
          acknowledge what happened and
          change how you act in the present.
        </p>

        <div class="sha-grid">

          <div class="sha-card">
            <span>SINCERITY</span>
            <h3>FACE THE TRUTH.</h3>
            <p>
              Recognize your circumstances,
              decisions, and consequences
              without making excuses.
            </p>
          </div>

          <div class="sha-card">
            <span>HARMONY</span>
            <h3>RESPECT OTHERS.</h3>
            <p>
              Make amends where possible,
              honor boundaries, and accept
              what cannot be repaired.
            </p>
          </div>

          <div class="sha-card">
            <span>PURIFICATION</span>
            <h3>MARK THE CHANGE.</h3>
            <p>
              Use spiritual reflection
              to acknowledge the past
              and renew your intentions.
            </p>
          </div>

          <div class="sha-card">
            <span>RENEWAL</span>
            <h3>LIVE DIFFERENTLY.</h3>
            <p>
              Let sobriety, accountability,
              and your present behavior
              demonstrate what matters.
            </p>
          </div>

        </div>

      </div>

    </div>
  </section>


  <!-- ENDING -->
  <section class="sha-ending">
    <div class="sha-ending-inner">

      <p class="sha-ending-label">
        SINCERITY. RESPONSIBILITY. RENEWAL.
      </p>

      <h2>
        ACKNOWLEDGE.<br>
        REPAIR.<br>
        PARTICIPATE.
      </h2>

      <p class="sha-ending-copy">
        Renewal does not require becoming someone
        who has never made mistakes. It means
        recognizing your history without allowing
        it to determine every future action.
        Stay sober, fulfill your responsibilities,
        respect boundaries, and allow your
        actions to demonstrate change.
      </p>

      <%= link_to "← BACK TO ADDICTION PERSPECTIVES",
          addiction_perspectives_path,
          class: "sha-back" %>

    </div>
  </section>

</main>