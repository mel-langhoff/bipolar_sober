  /* Buddhist addiction page: unindented paragraphs, including story sections */
  .buddhism-addiction-page .ba-copy p {
    text-indent: 0;
  }
  .buddhism-addiction-page .ba-copy > p {
    margin-bottom: 1.5em;
  }
  .buddhism-addiction-page .ba-copy em {
    font-style: italic;
  }
  .buddhism-addiction-page .ba-story-label {
    font-weight: 900;
    letter-spacing: .12em;
    font-size: .8rem;
    text-transform: uppercase;
  }
  .buddhism-addiction-page .ba-story-section .ba-copy {
    max-width: 850px;
  }
  .buddhism-addiction-page .ba-story-section .ba-callout {
    margin: 0 0 2.5rem;
  }
</style>
