<% content_for :title, "Paganism & Addiction | Bipolar Sober" %>

<style>
  /* ==========================================
     PAGANISM & ADDICTION
     ========================================== */

  .pga-page {
    --pga-black: #080808;
    --pga-pink: #ff1493;
    --pga-yellow: #eaff00;
    --pga-purple: #8a00ff;
    --pga-white: #ffffff;

    margin: 0;
    background: var(--pga-black);
    color: var(--pga-white);
    font-family: Arial, Helvetica, sans-serif;
  }

  .pga-page,
  .pga-page *,
  .pga-page *::before,
  .pga-page *::after {
    box-sizing: border-box;
  }

  .pga-page h1,
  .pga-page h2,
  .pga-page h3,
  .pga-page p {
    margin: 0;
  }

  /* HERO */

  .pga-page .pga-hero {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    min-height: 800px;
    min-height: max(800px, 100svh);
    padding: 130px 5vw 90px;
    background: var(--pga-black);
  }

  .pga-page .pga-picture {
    position: absolute;
    inset: 0;
    z-index: -2;
    display: block;
    width: 100%;
    height: 100%;
  }

  .pga-page .pga-picture img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: right center;
  }

  .pga-page .pga-hero::after {
    position: absolute;
    inset: 0;
    z-index: -1;
    content: "";
    pointer-events: none;
    background: linear-gradient(
      90deg,
      rgba(8, 8, 8, 0.4),
      transparent 75%
    );
  }

  .pga-page .pga-hero-content {
    width: 58%;
    max-width: 850px;
  }

  .pga-page .pga-eyebrow {
    margin-bottom: 30px;
    color: var(--pga-yellow);
    font-size: 12px;
    font-weight: 900;
    line-height: 1.7;
    letter-spacing: 0.1em;
  }

  .pga-page .pga-hero h1 {
    font-size: clamp(62px, 7vw, 130px);
    font-weight: 900;
    line-height: 0.94;
    letter-spacing: -0.06em;
    text-transform: uppercase;
  }

  .pga-page .pga-hero h1 span {
    display: block;
  }

  .pga-page .pga-intro {
    max-width: 520px;
    margin-top: 32px;
    font-size: clamp(14px, 1.3vw, 19px);
    font-weight: 800;
    line-height: 1.7;
  }

  /* SECTIONS */

  .pga-page .pga-section {
    padding: 85px 5vw;
  }

  .pga-page .pga-inner {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    align-items: start;
    gap: clamp(35px, 5vw, 90px);
    max-width: 1400px;
    margin: 0 auto;
  }

  .pga-page .pga-heading,
  .pga-page .pga-copy {
    min-width: 0;
  }

  .pga-page .pga-number {
    margin-bottom: 25px;
    font-size: 12px;
    font-weight: 900;
    line-height: 1.6;
    letter-spacing: 0.08em;
  }

  .pga-page .pga-heading h2 {
    font-size: clamp(38px, 4.5vw, 80px);
    font-weight: 900;
    line-height: 0.98;
    letter-spacing: -0.05em;
    overflow-wrap: break-word;
  }

  .pga-page .pga-copy > p {
    margin-bottom: 23px;
    font-size: 18px;
    line-height: 1.8;
  }

  .pga-page .pga-copy > p:last-child {
    margin-bottom: 0;
  }

  .pga-page .pga-copy > .pga-lead {
    font-size: clamp(21px, 2vw, 27px);
    font-weight: 800;
    line-height: 1.5;
    letter-spacing: -0.025em;
  }

  /* COLORS */

  .pga-page .pga-black {
    background: var(--pga-black);
    color: var(--pga-white);
  }

  .pga-page .pga-pink {
    background: var(--pga-pink);
    color: var(--pga-black);
  }

  .pga-page .pga-yellow {
    background: var(--pga-yellow);
    color: var(--pga-black);
  }

  .pga-page .pga-purple {
    background: var(--pga-purple);
    color: var(--pga-white);
  }

  .pga-page .pga-black .pga-number,
  .pga-page .pga-purple .pga-number {
    color: var(--pga-yellow);
  }

  /* CARDS */

  .pga-page .pga-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin: 30px 0;
  }

  .pga-page .pga-card {
    min-width: 0;
    padding: 24px;
    border: 2px solid currentColor;
  }

  .pga-page .pga-card span {
    display: block;
    margin-bottom: 17px;
    font-size: 11px;
    font-weight: 900;
    line-height: 1.5;
    letter-spacing: 0.08em;
  }

  .pga-page .pga-card h3 {
    margin-bottom: 15px;
    font-size: clamp(22px, 2vw, 29px);
    font-weight: 900;
    line-height: 1.1;
    letter-spacing: -0.035em;
    overflow-wrap: break-word;
  }

  .pga-page .pga-card p {
    font-size: 16px;
    line-height: 1.75;
  }

  /* CALLOUTS */

  .pga-page .pga-callout {
    margin: 30px 0;
    padding: 26px;
    border: 3px solid currentColor;
    font-size: clamp(22px, 2.4vw, 34px);
    font-weight: 900;
    line-height: 1.25;
    letter-spacing: -0.03em;
    overflow-wrap: break-word;
  }

  .pga-page .pga-black .pga-callout,
  .pga-page .pga-purple .pga-callout {
    color: var(--pga-yellow);
  }

  .pga-page .pga-stack {
    display: grid;
    gap: 12px;
    margin: 30px 0;
  }

  .pga-page .pga-stack p {
    padding: 18px 20px;
    border: 2px solid currentColor;
    font-size: 16px;
    font-weight: 800;
    line-height: 1.5;
  }

  /* ENDING */

  .pga-page .pga-ending {
    padding: 90px 5vw;
    background: var(--pga-black);
    color: var(--pga-white);
  }

  .pga-page .pga-ending-inner {
    max-width: 1400px;
    margin: 0 auto;
  }

  .pga-page .pga-ending-label {
    margin-bottom: 28px;
    color: var(--pga-yellow);
    font-size: 12px;
    font-weight: 900;
    line-height: 1.7;
    letter-spacing: 0.08em;
  }

  .pga-page .pga-ending h2 {
    margin-bottom: 30px;
    font-size: clamp(50px, 8vw, 125px);
    font-weight: 900;
    line-height: 0.94;
    letter-spacing: -0.06em;
  }

  .pga-page .pga-ending-copy {
    max-width: 680px;
    margin-bottom: 32px;
    font-size: 18px;
    line-height: 1.8;
  }

  .pga-page .pga-back {
    display: inline-block;
    max-width: 100%;
    padding: 17px 22px;
    border: 2px solid var(--pga-yellow);
    color: var(--pga-yellow);
    background: transparent;
    font-size: 13px;
    font-weight: 900;
    line-height: 1.5;
    text-decoration: none;
    transition:
      background-color 160ms ease,
      color 160ms ease;
  }

  .pga-page .pga-back:hover {
    background: var(--pga-yellow);
    color: var(--pga-black);
  }

  .pga-page .pga-back:focus-visible {
    outline: 3px solid var(--pga-white);
    outline-offset: 5px;
  }

  /* TABLET */

  @media (max-width: 1000px) {
    .pga-page .pga-inner {
      grid-template-columns: minmax(0, 1fr);
      max-width: 850px;
      gap: 35px;
    }

    .pga-page .pga-heading h2 {
      font-size: clamp(45px, 7vw, 75px);
    }
  }

  /* MOBILE */

  @media (max-width: 767px) {
    .pga-page .pga-hero {
      align-items: flex-start;
      min-height: 1000px;
      min-height: max(1000px, 125svh);
      padding: 110px 22px 60px;
    }

    .pga-page .pga-picture img {
      object-position: center bottom;
    }

    .pga-page .pga-hero::after {
      background: linear-gradient(
        180deg,
        rgba(8, 8, 8, 0.15),
        transparent 70%
      );
    }

    .pga-page .pga-hero-content {
      width: 100%;
      max-width: 550px;
    }

    .pga-page .pga-eyebrow {
      margin-bottom: 27px;
      font-size: 10px;
      letter-spacing: 0.06em;
    }

    .pga-page .pga-hero h1 {
      font-size: clamp(44px, 11vw, 82px);
    }

    .pga-page .pga-intro {
      margin-top: 27px;
      font-size: 13px;
    }

    .pga-page .pga-section {
      padding: 60px 22px;
    }

    .pga-page .pga-heading h2 {
      font-size: clamp(38px, 10vw, 65px);
    }

    .pga-page .pga-copy > p {
      font-size: 17px;
    }

    .pga-page .pga-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .pga-page .pga-card h3 {
      font-size: 26px;
    }

    .pga-page .pga-callout {
      padding: 23px;
      font-size: 25px;
    }

    .pga-page .pga-ending {
      padding: 70px 22px;
    }

    .pga-page .pga-ending h2 {
      font-size: clamp(45px, 11vw, 80px);
    }

    .pga-page .pga-ending-copy {
      font-size: 17px;
    }
  }
</style>



<main class="pga-page">

  <!-- HERO -->
  <section class="pga-hero">

    <picture class="pga-picture">
      <source
        media="(max-width: 767px)"
        srcset="<%= asset_path('addiction_paganism_mobile.png') %>">

      <%= image_tag "addiction_paganism_desktop.png",
          alt: "",
          fetchpriority: "high" %>
    </picture>

    <div class="pga-hero-content">

      <p class="pga-eyebrow">
        BIPOLAR SOBER / ADDICTION / PERSPECTIVES / PAGANISM
      </p>

      <h1>
        <span>ADDICTION</span>
        <span>THROUGH A</span>
        <span>PAGAN LENS.</span>
      </h1>

      <p class="pga-intro">
        RELATIONSHIP. RESPONSIBILITY. RENEWAL.<br>
        WHAT KIND OF LIFE ARE YOU CULTIVATING?
      </p>

    </div>

  </section>


  <!-- 01 / THE PERSPECTIVE -->
  <section class="pga-section pga-black">
    <div class="pga-inner">

      <div class="pga-heading">
        <p class="pga-number">01 / A WAY OF LOOKING</p>

        <h2>
          LOOK AT<br>
          WHAT YOUR<br>
          LIFE TOUCHES.
        </h2>
      </div>

      <div class="pga-copy">

        <p class="pga-lead">
          Your freedom exists alongside your responsibilities.
        </p>

        <p>
          Paganism examines addiction through connection,
          balance, personal sovereignty, responsibility,
          and the natural cycles of life. Although Pagan
          traditions differ, many emphasize living in
          harmony with yourself, others, and the natural
          world. Addiction can disrupt these relationships
          by prioritizing immediate relief over long-term
          well-being.
        </p>

        <p>
          A Pagan perspective encourages you to recognize
          recurring patterns, respect your body's needs,
          and understand that personal freedom comes with
          responsibility for how your actions affect others.
        </p>

        <div class="pga-callout">
          FREEDOM DOESN'T<br>
          ERASE CONSEQUENCES.
        </div>

      </div>

    </div>
  </section>


  <!-- 02 / THE BODY -->
  <section class="pga-section pga-pink">
    <div class="pga-inner">

      <div class="pga-heading">
        <p class="pga-number">02 / YOUR BODY &amp; YOUR NEEDS</p>

        <h2>
          YOUR PAIN<br>
          DESERVES<br>
          ATTENTION.
        </h2>
      </div>

      <div class="pga-copy">

        <p class="pga-lead">
          FIRST DUI / PHYSICAL SUFFERING &amp; ESCAPE
        </p>

        <p>
          In your First DUI, severe sciatica pain left
          you trapped in a body that no longer allowed
          you to live independently. Watching an older
          cyclist reminded you of the physical freedom
          and pain-free life you had lost. You were
          angry at your body for limiting you.
        </p>

        <p>
          Drinking became both an attempt to care for
          your body and a way to escape it. Alcohol
          temporarily relieved your suffering, but
          you became attached to that relief. Your
          decision to drink and drive ultimately
          endangered others and created additional harm.
        </p>

        <div class="pga-grid">

          <div class="pga-card">
            <span>THE NEED</span>
            <h3>RELIEF &amp; FREEDOM.</h3>
            <p>
              You wanted relief from physical pain
              and the freedom to live independently.
            </p>
          </div>

          <div class="pga-card">
            <span>THE RESPONSE</span>
            <h3>ESCAPE &amp; CONSEQUENCE.</h3>
            <p>
              Alcohol provided temporary relief,
              but your decisions created consequences
              for yourself and others.
            </p>
          </div>

        </div>

        <p>
          Restoring balance involved acknowledging
          your actions, apologizing, making amends,
          and completing your court-ordered
          responsibilities. Your suffering was real,
          but it did not remove your responsibility
          for the harm you caused.
        </p>

      </div>

    </div>
  </section>


  <!-- 03 / SOVEREIGNTY -->
  <section class="pga-section pga-yellow">
    <div class="pga-inner">

      <div class="pga-heading">
        <p class="pga-number">03 / FREEDOM &amp; RESPONSIBILITY</p>

        <h2>
          NO RULES?<br>
          STILL YOUR<br>
          ACTIONS.
        </h2>
      </div>

      <div class="pga-copy">

        <p class="pga-lead">
          THIRD DUI / PERSONAL SOVEREIGNTY
        </p>

        <p>
          Your Third DUI illustrates the conflict
          between personal freedom and responsibility.
          Mania impaired your judgment and intensified
          your impulsivity, making it difficult to
          maintain control over your decisions.
        </p>

        <p>
          When the interlock malfunctioned, you
          experienced it as freedom from rules and
          restrictions. You wanted to escape your
          responsibilities and live according to
          your immediate desires. Drinking represented
          an opportunity to do what you wanted without
          considering what would follow.
        </p>

        <div class="pga-callout">
          NO RULES.<br>
          NO RESTRAINT.<br>
          REAL CONSEQUENCES.
        </div>

        <p>
          Personal sovereignty doesn't mean freedom
          from consequences. Although mania affected
          your judgment, you remain responsible for
          your actions. Restoring balance involved
          accepting those consequences and complying
          with the court's requirements.
        </p>

      </div>

    </div>
  </section>


  <!-- 04 / RECIPROCITY -->
  <section class="pga-section pga-purple">
    <div class="pga-inner">

      <div class="pga-heading">
        <p class="pga-number">04 / RECIPROCITY &amp; RELATIONSHIP</p>

        <h2>
          CONNECTION<br>
          GOES BOTH<br>
          WAYS.
        </h2>
      </div>

      <div class="pga-copy">

        <p class="pga-lead">
          PRESS SEND / REASSURANCE &amp; BOUNDARIES
        </p>

        <p>
          In Press Send, intoxication disrupted how
          you communicated and interacted with people
          you cared about. You wanted reassurance,
          contact, and love, but your attempts to
          obtain those things sometimes left others
          frustrated, hurt, or upset.
        </p>

        <p>
          Pagan ideas about reciprocity emphasize
          that relationships involve mutual respect.
          Your need for connection does not override
          another person's right to establish boundaries
          or make decisions independently of you.
        </p>

        <div class="pga-stack">
          <p>YOUR NEEDS MATTER.</p>
          <p>THEIR BOUNDARIES MATTER.</p>
          <p>CONNECTION REQUIRES RECIPROCITY.</p>
        </div>

        <p>
          Restoring harmony means recognizing the effects
          of your communication, respecting boundaries,
          and accepting that other people have the right
          to decide how and when they engage with you.
        </p>

      </div>

    </div>
  </section>


  <!-- 05 / RITUAL -->
  <section class="pga-section pga-black">
    <div class="pga-inner">

      <div class="pga-heading">
        <p class="pga-number">05 / RITUAL &amp; INTENTION</p>

        <h2>
          MAKE YOUR<br>
          INTENTIONS<br>
          MEAN SOMETHING.
        </h2>
      </div>

      <div class="pga-copy">

        <p>
          Rituals can help mark intentions, acknowledge
          difficult experiences, and establish meaningful
          routines. Meditation, offerings, journaling,
          time outdoors, or creative practices can support
          your connection with yourself and your
          spiritual beliefs.
        </p>

        <p>
          But rituals alone cannot repair harm or
          prevent destructive patterns. Your actions
          must reflect the intentions behind them.
          An apology requires accountability.
          A commitment requires follow-through.
          Recovery requires more than symbolic renewal.
        </p>

        <div class="pga-grid">

          <div class="pga-card">
            <span>INTENTION</span>
            <h3>WHAT MATTERS?</h3>
            <p>
              Identify the relationships, values,
              and responsibilities you want to honor.
            </p>
          </div>

          <div class="pga-card">
            <span>ACTION</span>
            <h3>WHAT WILL YOU DO?</h3>
            <p>
              Turn those intentions into practical
              decisions and consistent behavior.
            </p>
          </div>

        </div>

      </div>

    </div>
  </section>


  <!-- 06 / CYCLES -->
  <section class="pga-section pga-pink">
    <div class="pga-inner">

      <div class="pga-heading">
        <p class="pga-number">06 / CYCLES &amp; RENEWAL</p>

        <h2>
          RECOGNIZE<br>
          THE<br>
          PATTERN.
        </h2>
      </div>

      <div class="pga-copy">

        <p>
          Many Pagan traditions recognize natural
          cycles of growth, decline, rest, and renewal.
          Addiction can also involve repeated patterns:
          seeking relief, experiencing temporary
          satisfaction, facing consequences, and
          returning to familiar behavior.
        </p>

        <p>
          Recognizing these cycles allows you to
          examine where they begin and how they might
          change. Renewal does not mean pretending
          previous experiences never happened.
          It means acknowledging the past and
          changing how you live in the present.
        </p>

        <div class="pga-callout">
          RECOGNIZE.<br>
          REPAIR.<br>
          RENEW.
        </div>

        <p>
          Natural cycles do not make relapse inevitable,
          and bipolar episodes require medical understanding.
          Spiritual reflection can help you examine
          your patterns alongside treatment, support,
          and practical planning.
        </p>

      </div>

    </div>
  </section>


  <!-- 07 / ACCOUNTABILITY -->
  <section class="pga-section pga-yellow">
    <div class="pga-inner">

      <div class="pga-heading">
        <p class="pga-number">07 / VALUES &amp; ACCOUNTABILITY</p>

        <h2>
          OWN IT.<br>
          MAKE<br>
          AMENDS.
        </h2>
      </div>

      <div class="pga-copy">

        <p class="pga-lead">
          Understanding your behavior doesn't
          eliminate your responsibility for it.
        </p>

        <p>
          Across your experiences, your desire for
          physical relief, independence, or emotional
          reassurance was understandable. But the
          actions you took sometimes disrupted
          relationships, endangered others, and
          created consequences that remain part
          of your life.
        </p>

        <div class="pga-grid">

          <div class="pga-card">
            <span>UNDERSTANDING</span>
            <h3>WHY DID IT HAPPEN?</h3>
            <p>
              Examine the pain, desires,
              circumstances, and patterns
              that influenced your behavior.
            </p>
          </div>

          <div class="pga-card">
            <span>RESPONSIBILITY</span>
            <h3>WHAT FOLLOWS?</h3>
            <p>
              Acknowledge harm, make amends
              where possible, respect boundaries,
              and accept consequences.
            </p>
          </div>

        </div>

        <p>
          Accountability involves more than
          completing legal obligations or
          apologizing. It also means developing
          behaviors that better reflect your values
          and reduce the likelihood of repeating
          harmful patterns.
        </p>

      </div>

    </div>
  </section>


  <!-- 08 / THE BIGGER PICTURE -->
  <section class="pga-section pga-purple">
    <div class="pga-inner">

      <div class="pga-heading">
        <p class="pga-number">08 / THE BIGGER PICTURE</p>

        <h2>
          FREEDOM.<br>
          CONNECTION.<br>
          BALANCE.
        </h2>
      </div>

      <div class="pga-copy">

        <p>
          Your First DUI involved the loss of physical
          independence and an attempt to escape pain.
          Your Third DUI involved a desire for freedom
          from restrictions and responsibility.
          Press Send involved a need for reassurance
          and connection that sometimes damaged
          the very relationships you wanted to preserve.
        </p>

        <p>
          Although the circumstances differed,
          these experiences reveal how the pursuit
          of immediate relief can disrupt the
          relationships and responsibilities that
          support your life.
        </p>

        <p>
          Paganism offers a way to consider
          how freedom, connection, and accountability
          coexist. Restoring balance doesn't mean
          returning to a life without consequences.
          It means recognizing what happened,
          addressing the harm where possible,
          and living according to your values now.
        </p>

      </div>

    </div>
  </section>


  <!-- ENDING -->
  <section class="pga-ending">
    <div class="pga-ending-inner">

      <p class="pga-ending-label">
        ATTENTION. RELATIONSHIP. RESPONSIBILITY.
      </p>

      <h2>
        REMEMBER.<br>
        RECONNECT.<br>
        CULTIVATE.
      </h2>

      <p class="pga-ending-copy">
        You cannot erase what happened, but you can
        acknowledge the harm, make amends where possible,
        and develop a life that better reflects your values.
        Renewal isn't about forgetting the past.
        It's about taking responsibility for the
        life you're living now.
      </p>

      <%= link_to "← BACK TO ADDICTION PERSPECTIVES",
          addiction_perspectives_path,
          class: "pga-back" %>

    </div>
  </section>

</main>
