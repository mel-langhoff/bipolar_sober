<% content_for :title, "Perspectives on Bipolar | Bipolar Sober" %>

<main class="bipolar-perspectives-page">

  <!-- HERO -->
  <section class="bipolar-perspectives-hero">

    <div class="bipolar-perspectives-hero-content">

      <p class="bipolar-perspectives-eyebrow">
        BIPOLAR SOBER / BIPOLAR / PERSPECTIVES
      </p>

      <h1>
        <span>ANOTHER</span>
        <span>WAY TO</span>
        <span>LOOK AT IT.</span>
      </h1>

      <p class="bipolar-perspectives-intro">
        SAME BRAIN.<br>
        DIFFERENT LENS.
      </p>

      <a href="#perspective-options" class="bipolar-perspectives-button">
        CHANGE THE VIEW ↓
      </a>

    </div>

  </section>


  <!-- PERSPECTIVES -->
  <section class="bipolar-perspectives-topics" id="perspective-options">

    <div class="bipolar-perspectives-heading">

      <p>
        01 / PERSPECTIVES ON BIPOLAR
      </p>

      <h2>
        PICK A<br>
        LENS.
      </h2>

      <p class="bipolar-perspectives-subtitle">
        A diagnosis can explain some things without explaining
        everything. Here are a few different ways to think about
        suffering, thoughts, emotions, behavior, identity, and
        living with bipolar disorder.
      </p>

    </div>


    <div class="bipolar-perspectives-grid">


      <!-- BUDDHISM -->
      <%= link_to bipolar_buddhism_path,
          class: "bipolar-perspective-card bp-card-pink" do %>

        <p class="bipolar-perspective-number">
          01
        </p>

        <h3>
          BUDDHISM
        </h3>

        <p class="bipolar-perspective-description">
          Suffering, craving, attachment, impermanence,
          mindfulness, compassion, and learning to observe
          what's happening without becoming all of it.
        </p>

        <span>
          SEE IT DIFFERENTLY →
        </span>

      <% end %>


      <!-- HINDUISM -->
      <%= link_to bipolar_hinduism_path,
          class: "bipolar-perspective-card bp-card-yellow" do %>

        <p class="bipolar-perspective-number">
          02
        </p>

        <h3>
          HINDUISM
        </h3>

        <p class="bipolar-perspective-description">
          Dharma, karma, the self, discipline, acceptance,
          and what ancient ideas can offer when your internal
          world feels anything but orderly.
        </p>

        <span>
          EXPLORE →
        </span>

      <% end %>


      <!-- STOICISM -->
      <%= link_to bipolar_stoicism_path,
          class: "bipolar-perspective-card bp-card-purple" do %>

        <p class="bipolar-perspective-number">
          03
        </p>

        <h3>
          STOICISM
        </h3>

        <p class="bipolar-perspective-description">
          What's actually in your control? What isn't?
          A different way to approach circumstances,
          reactions, discomfort, and uncertainty.
        </p>

        <span>
          FOCUS ON WHAT'S YOURS →
        </span>

      <% end %>


      <!-- CBT -->
      <%= link_to bipolar_cbt_path,
          class: "bipolar-perspective-card bp-card-black" do %>

        <p class="bipolar-perspective-number">
          04
        </p>

        <h3>
          CBT
        </h3>

        <p class="bipolar-perspective-description">
          Your first thought isn't necessarily the truth.
          Look for cognitive distortions, question the story,
          and see what the evidence actually says.
        </p>

        <span>
          QUESTION THE THOUGHT →
        </span>

      <% end %>


      <!-- DBT -->
      <%= link_to bipolar_dbt_path,
          class: "bipolar-perspective-card bp-card-split" do %>

        <p class="bipolar-perspective-number">
          05
        </p>

        <h3>
          DBT
        </h3>

        <p class="bipolar-perspective-description">
          Acceptance and change can exist at the same time.
          Emotional regulation, distress tolerance,
          mindfulness, and surviving intense moments.
        </p>

        <span>
          FIND THE MIDDLE →
        </span>

      <% end %>


      <!-- IFS -->
      <%= link_to bipolar_ifs_path,
          class: "bipolar-perspective-card bp-card-pink" do %>

        <p class="bipolar-perspective-number">
          06
        </p>

        <h3>
          IFS
        </h3>

        <p class="bipolar-perspective-description">
          Instead of treating every conflicting impulse as an enemy,
          look at parts, protectors, wounds, and what those different
          pieces of you might actually be trying to do.
        </p>

        <span>
          MEET YOUR PARTS →
        </span>

      <% end %>


      <!-- THE BIG PICTURE -->
<%= link_to bipolar_big_picture_path,
    class: "bipolar-perspective-card bp-card-big-picture" do %>

  <p class="bipolar-perspective-number">
    07 / PUTTING IT ALL TOGETHER
  </p>

  <h3>
    THE BIG<br>
    PICTURE
  </h3>

  <p class="bipolar-perspective-description">
    Buddhism. Hinduism. Stoicism. CBT. DBT. IFS.
    Different languages, different ideas, different tools —
    but some surprisingly similar lessons about suffering,
    thoughts, emotions, acceptance, control, identity, and change.
  </p>

  <span>
    PUT IT ALL TOGETHER →
  </span>

<% end %>
    </div>

  </section>

</main>