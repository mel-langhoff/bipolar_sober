<% content_for :title, "Toolbox | Bipolar Sober" %>

<main class="toolbox-page">

  <!-- HERO -->
  <section class="toolbox-hero">
    <div class="toolbox-hero-content">

      <p class="toolbox-eyebrow">
        BIPOLAR SOBER / TOOLBOX
      </p>

      <h1>
        <span>THE</span>
        <span>TOOLBOX.</span>
      </h1>

      <p class="toolbox-intro">
        WHEN YOUR BRAIN IS<br>
        BEING AN ASSHOLE,<br>
        TRY SOMETHING.
      </p>

      <a href="#toolbox-tools" class="toolbox-button">
        OPEN THE BOX ↓
      </a>

    </div>
  </section>


  <!-- TOOLS -->
  <section class="toolbox-tools" id="toolbox-tools">

    <div class="toolbox-heading">

      <p>01 / TOOLBOX</p>

      <h2>
        WHAT DO<br>
        YOU NEED?
      </h2>

      <p class="toolbox-subtitle">
        You don't have to fix your entire fucking life right now.
        Pick a tool. Try it. See what happens.
      </p>

    </div>


    <div class="toolbox-grid">

      <!-- GROUNDING -->
      <a href="#" class="toolbox-card toolbox-card-pink">

        <p class="toolbox-card-number">01</p>

        <h3>
          GROUNDING
        </h3>

        <p class="toolbox-card-description">
          Get out of the spiral and back into the room.
          Simple ways to reconnect with your body, your senses,
          and what's actually happening right now.
        </p>

        <span>COME BACK DOWN →</span>

      </a>


      <!-- JOURNALING -->
      <a href="#" class="toolbox-card toolbox-card-yellow">

        <p class="toolbox-card-number">02</p>

        <h3>
          JOURNALING
        </h3>

        <p class="toolbox-card-description">
          Get the shit out of your head and onto paper.
          Prompts, inventories, reflection exercises, and ways
          to figure out what you're actually thinking.
        </p>

        <span>WRITE IT OUT →</span>

      </a>


      <!-- MINDFULNESS -->
      <a href="#" class="toolbox-card toolbox-card-purple">

        <p class="toolbox-card-number">03</p>

        <h3>
          MINDFULNESS
        </h3>

        <p class="toolbox-card-description">
          Notice what's happening without immediately reacting to it.
          Breathing, meditation, observation, and learning how
          to stay in the present moment.
        </p>

        <span>BE HERE →</span>

      </a>


      <!-- EMOTIONAL REGULATION -->
      <a href="#" class="toolbox-card toolbox-card-black">

        <p class="toolbox-card-number">04</p>

        <h3>
          EMOTIONAL<br>
          REGULATION
        </h3>

        <p class="toolbox-card-description">
          Anger. Anxiety. Depression. Overwhelm.
          Things to try when your emotions have grabbed the steering wheel.
        </p>

        <span>REGULATE →</span>

      </a>


      <!-- EMERGENCY PLANS -->
      <a href="#" class="toolbox-card toolbox-card-split">

        <p class="toolbox-card-number">05</p>

        <h3>
          EMERGENCY<br>
          PLANS
        </h3>

        <p class="toolbox-card-description">
          Don't wait until everything is on fire to decide where
          the extinguisher is. Make the plan while you can think clearly.
        </p>

        <span>MAKE A PLAN →</span>

      </a>


      <!-- SELF CARE -->
      <a href="#" class="toolbox-card toolbox-card-pink">

        <p class="toolbox-card-number">06</p>

        <h3>
          SELF-CARE
        </h3>

        <p class="toolbox-card-description">
          Sleep. Food. Water. Movement. Boundaries. Connection.
          The boring little things that become very fucking important
          when they disappear.
        </p>

        <span>TAKE CARE OF YOURSELF →</span>

      </a>

    </div>

  </section>

</main>