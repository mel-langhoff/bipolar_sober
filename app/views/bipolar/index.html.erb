
<% content_for :title, "Bipolar | Bipolar Sober" %>

<main class="bipolar-page">

  <!-- HERO -->
  <section class="bipolar-hero">
    <div class="bipolar-hero-content">

      <p class="bipolar-eyebrow">
        BIPOLAR SOBER / BIPOLAR
      </p>

      <h1>
        <span>ON</span>
        <span>BIPOLAR.</span>
      </h1>

      <p class="bipolar-intro">
        THE HIGHS. THE LOWS.<br>
        THE RAGE. THE CHAOS.<br>
        AND EVERYTHING IN BETWEEN.
      </p>

    </div>
  </section>


  <!-- TOPICS -->
  <section class="bipolar-topics" id="bipolar-topics">

    <div class="bipolar-topics-heading">

      <p>01 / BIPOLAR</p>

      <h2>
        PICK YOUR<br>
        BULLSHIT.
      </h2>

      <p class="bipolar-topics-subtitle">
        Understanding what the hell your brain is doing
        is a pretty good place to start.
      </p>

    </div>

    <div class="bipolar-grid">

      <!-- PERSPECTIVES -->
      <%= link_to bipolar_perspectives_path,
          class: "bipolar-card card-pink" do %>

        <p class="bipolar-card-number">01</p>

        <h3>
          PERSPECTIVES<br>
          ON BIPOLAR
        </h3>

        <p class="bipolar-card-description">
          Buddhism, Hinduism, Stoicism, Taoism, Paganism,
          Shinto, CBT, DBT, and IFS. Nine different ways
          to understand your brain, question your thinking,
          and navigate life with bipolar disorder.
        </p>

        <span>EXPLORE →</span>

      <% end %>


      <!-- ANGER -->
      <%= link_to bipolar_anger_path,
          class: "bipolar-card card-yellow" do %>

        <p class="bipolar-card-number">02</p>

        <h3>
          ON<br>
          ANGER
        </h3>

        <p class="bipolar-card-description">
          The short fuse, disproportionate reactions,
          and getting pissed off at everything.
          Understanding bipolar irritability and
          learning when to put the thing down.
        </p>

        <span>EXPLORE →</span>

      <% end %>


      <!-- MANIA -->
      <%= link_to bipolar_mania_path,
          class: "bipolar-card card-purple" do %>

        <p class="bipolar-card-number">03</p>

        <h3>
          ON<br>
          MANIA
        </h3>

        <p class="bipolar-card-description">
          Racing thoughts, too much confidence, too little
          sleep, impulsive decisions, psychosis, and the dangerous
          feeling that every idea needs to happen right now.
        </p>

        <span>EXPLORE →</span>

      <% end %>


      <!-- DEPRESSION -->
      <%= link_to bipolar_depression_path,
          class: "bipolar-card card-black" do %>

        <p class="bipolar-card-number">04</p>

        <h3>
          ON<br>
          DEPRESSION
        </h3>

        <p class="bipolar-card-description">
          Not just feeling sad. Months of exhaustion,
          disconnection, lost motivation, and trying
          to function when even the smallest things
          feel like too much.
        </p>

        <span>EXPLORE →</span>

      <% end %>


      <!-- MIXED EPISODES -->
      <%= link_to bipolar_mixed_episodes_path,
          class: "bipolar-card card-split" do %>

        <p class="bipolar-card-number">05</p>

        <h3>
          ON MIXED<br>
          EPISODES
        </h3>

        <p class="bipolar-card-description">
          Depressed but wired. Exhausted but restless.
          Racing thoughts and miserable feelings
          occupying the same brain at the same time.
          The worst of both worlds.
        </p>

        <span>EXPLORE →</span>

      <% end %>


      <!-- IMPULSIVITY -->
      <%= link_to bipolar_impulsivity_path,
          class: "bipolar-card card-pink" do %>

        <p class="bipolar-card-number">06</p>

        <h3>
          ON<br>
          IMPULSIVITY
        </h3>

        <p class="bipolar-card-description">
          Spending, sudden decisions, questionable ideas,
          and the dangerously short gap between wanting
          something and doing it. Getting the "fuck it's". 
          Learning to pause
          before the consequences show up.
        </p>

        <span>EXPLORE →</span>

      <% end %>


      <!-- PSYCHOSIS -->
      <%= link_to bipolar_psychosis_path,
          class: "bipolar-card card-purple" do %>

        <p class="bipolar-card-number">07</p>

        <h3>
          ON<br>
          PSYCHOSIS
        </h3>

        <p class="bipolar-card-description">
          Hearing things, seeing things, believing things
          that aren't happening, and trying to distinguish
          reality from what your brain insists is real. Not only having the experience
          but reliving it.
        </p>

        <span>EXPLORE →</span>

      <% end %>


      <!-- MEDICATIONS -->
      <%= link_to bipolar_medications_path,
          class: "bipolar-card card-yellow" do %>

        <p class="bipolar-card-number">08</p>

        <h3>
          ON<br>
          MEDICATIONS
        </h3>

        <p class="bipolar-card-description">
          The Carousel of Medicine. Five and a half years
          of different pills, changing dosages, waiting,
          weight gain, and other insane side effects before finally
          finding a combination that works.
        </p>

        <span>LOOK AT THE WHOLE PICTURE →</span>

      <% end %>


      <!-- MOOD SWINGS -->
      <%= link_to bipolar_mood_swings_path,
          class: "bipolar-card card-pink" do %>

        <p class="bipolar-card-number">09</p>

        <h3>
          ON<br>
          MOOD SWINGS
        </h3>

        <p class="bipolar-card-description">
          What's the difference between a normal mood swing
          and a bipolar episode? Understanding the duration,
          intensity, and changes in sleep, energy, judgment,
          and behavior that make bipolar different.
        </p>

        <span>EXPLORE →</span>

      <% end %>

    </div>
  </section>


  <!-- BACK TO HOME -->
  <nav class="index-home-nav" aria-label="Return home">

    <%= link_to "← BACK TO HOME",
        root_path,
        class: "index-home-button" %>

  </nav>

</main>
