<% content_for :title, "Bipolar | Bipolar Sober" %>

<main class="bipolar-page">

  <!-- HERO -->
  <section class="bipolar-hero">
    <div class="bipolar-hero-content">

      <p class="bipolar-eyebrow">
        BIPOLAR SOBER / BIPOLAR
      </p>

      <h1>
        <span>ON</span>
        <span>BIPOLAR.</span>
      </h1>

      <p class="bipolar-intro">
        THE HIGHS. THE LOWS.<br>
        THE RAGE. THE CHAOS.<br>
        AND EVERYTHING IN BETWEEN.
      </p>

    </div>
  </section>

  <!-- TOPICS -->
  <section class="bipolar-topics" id="bipolar-topics">

    <div class="bipolar-topics-heading">

      <p>01 / BIPOLAR</p>

      <h2>
        PICK YOUR<br>
        BULLSHIT.
      </h2>

      <p class="bipolar-topics-subtitle">
        Understanding what the hell your brain is doing
        is a pretty good place to start.
      </p>

    </div>

    <div class="bipolar-grid">

      <!-- PERSPECTIVES -->
      <%= link_to bipolar_perspectives_path,
          class: "bipolar-card card-pink" do %>

        <p class="bipolar-card-number">01</p>

        <h3>
          PERSPECTIVES<br>
          ON BIPOLAR
        </h3>

        <p class="bipolar-card-description">
          Buddhism, Hinduism, Stoicism, CBT, DBT, IFS,
          and different ways of looking at bipolar disorder,
          recovery, identity, and living with your own brain.
        </p>

        <span>EXPLORE →</span>

      <% end %>

      <!-- ANGER -->
      <%= link_to bipolar_anger_path,
          class: "bipolar-card card-yellow" do %>

        <p class="bipolar-card-number">02</p>

        <h3>
          ON<br>
          ANGER
        </h3>

        <p class="bipolar-card-description">
          Rage, irritability, hair-trigger reactions,
          and what happens when zero suddenly becomes one hundred.
        </p>

        <span>EXPLORE →</span>

      <% end %>

      <!-- MANIA -->
      <%= link_to bipolar_mania_path,
          class: "bipolar-card card-purple" do %>

        <p class="bipolar-card-number">03</p>

        <h3>
          ON<br>
          MANIA
        </h3>

        <p class="bipolar-card-description">
          When everything gets faster, louder, brighter,
          bigger, and considerably more complicated.
        </p>

        <span>EXPLORE →</span>

      <% end %>

      <!-- DEPRESSION -->
      <%= link_to bipolar_depression_path,
          class: "bipolar-card card-black" do %>

        <p class="bipolar-card-number">04</p>

        <h3>
          ON<br>
          DEPRESSION
        </h3>

        <p class="bipolar-card-description">
          The other side of the swing: exhaustion,
          emptiness, hopelessness, and getting through
          the fucking thing.
        </p>

        <span>EXPLORE →</span>

      <% end %>

      <!-- MIXED EPISODES -->
      <%= link_to bipolar_mixed_episodes_path,
          class: "bipolar-card card-split" do %>

        <p class="bipolar-card-number">05</p>

        <h3>
          ON MIXED<br>
          EPISODES
        </h3>

        <p class="bipolar-card-description">
          Depressed and wired. Exhausted and agitated.
          When opposite symptoms decide to show up together.
        </p>

        <span>EXPLORE →</span>

      <% end %>

      <!-- IMPULSIVITY -->
      <%= link_to bipolar_impulsivity_path,
          class: "bipolar-card card-pink" do %>

        <p class="bipolar-card-number">06</p>

        <h3>
          ON<br>
          IMPULSIVITY
        </h3>

        <p class="bipolar-card-description">
          The idea. The urge. The decision. The consequences.
          And learning how to put something between them.
        </p>

        <span>EXPLORE →</span>

      <% end %>



      <!-- PSYCHOSIS -->
      <%= link_to bipolar_psychosis_path,
          class: "bipolar-card card-purple" do %>

        <p class="bipolar-card-number">07</p>

        <h3>
          ON<br>
          PSYCHOSIS
        </h3>

        <p class="bipolar-card-description">
          When perception and reality stop lining up.
          Delusions, hallucinations, altered beliefs,
          and trying to make sense of what your mind
          is telling you.
        </p>

        <span>EXPLORE →</span>

      <% end %>

<!-- MEDICATIONS -->
<%= link_to bipolar_medications_path,
    class: "bipolar-card card-yellow" do %>

  <p class="bipolar-card-number">08</p>

  <h3>
    ON<br>
    MEDICATIONS
  </h3>

  <p class="bipolar-card-description">
    Taking your meds is part of your routine. It doesn’t erase
    the work of living with bipolar disorder, and struggling
    with symptoms doesn’t mean you’ve failed at treatment.
  </p>

  <span>LOOK AT THE WHOLE PICTURE →</span>

<% end %>

      <!-- MOOD SWINGS -->
      <%= link_to bipolar_mood_swings_path,
          class: "bipolar-card card-pink" do %>

        <p class="bipolar-card-number">09</p>

        <h3>
          ON<br>
          MOOD SWINGS
        </h3>

        <p class="bipolar-card-description">
          Shifts in mood, energy, and irritability.
          What you notice, how it affects your day,
          and where it fits among the other topics.
        </p>

        <span>EXPLORE →</span>

      <% end %>
    </div>
  </section>


<!-- BACK TO HOME -->
<nav class="index-home-nav" aria-label="Return home">
  <%= link_to "← BACK TO HOME",
      root_path,
      class: "index-home-button" %>
</nav>


</main>