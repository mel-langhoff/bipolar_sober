        <%= link_to "← BACK TO BIPOLAR",
            bipolar_path,
            class: "psychosis-back" %>

        <%= link_to "ON MEDICATIONS →",
            bipolar_medications_path,
            class: "psychosis-back" %>

      </nav>

    </div>
  </section>
