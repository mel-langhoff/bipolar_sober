<% content_for :title, "Perspectives on Addiction | Bipolar Sober" %>

<main class="bipolar-perspectives-page addiction-perspectives-index">

  <!-- HERO -->
  <section class="bipolar-perspectives-hero">

    <div class="bipolar-perspectives-hero-content">

      <p class="bipolar-perspectives-eyebrow">
        BIPOLAR SOBER / ADDICTION / PERSPECTIVES
      </p>

      <h1>
        <span>ANOTHER</span>
        <span>WAY TO</span>
        <span>LOOK AT IT.</span>
      </h1>

      <p class="bipolar-perspectives-intro">
        MORE THAN ONE STORY.<br>
        DIFFERENT FUCKING LENSES.
      </p>

      <a href="#addiction-perspective-options"
         class="bipolar-perspectives-button">
        CHANGE THE VIEW ↓
      </a>

    </div>

  </section>


  <!-- PERSPECTIVES -->
  <section class="bipolar-perspectives-topics"
           id="addiction-perspective-options">

    <div class="bipolar-perspectives-heading">

      <p>
        01 / PERSPECTIVES ON ADDICTION
      </p>

      <h2>
        PICK A<br>
        LENS.
      </h2>

      <p class="bipolar-perspectives-subtitle">
        Addiction involves behavior, suffering, habits, relationships,
        and the environments in which you learn to live. Explore
        different ways to understand your experience, take responsibility,
        and build a life in recovery.
      </p>

    </div>


    <div class="bipolar-perspectives-grid">

      <!-- BUDDHISM -->
      <%= link_to addiction_perspectives_buddhism_path,
          class: "bipolar-perspective-card bp-card-pink" do %>

        <p class="bipolar-perspective-number">
          01
        </p>

        <h3>
          BUDDHISM
        </h3>

        <p class="bipolar-perspective-description">
          Suffering, craving, attachment, impermanence,
          mindfulness, and compassion. Examine your relationship
          with relief and what it means to live with greater awareness.
        </p>

        <span>
          LOOK A LITTLE CLOSER →
        </span>

      <% end %>


      <!-- HINDUISM -->
      <%= link_to addiction_perspectives_hinduism_path,
          class: "bipolar-perspective-card bp-card-yellow" do %>

        <p class="bipolar-perspective-number">
          02
        </p>

        <h3>
          HINDUISM
        </h3>

        <p class="bipolar-perspective-description">
          The Self, discernment, dharma, devotion, and non-harming.
          Explore identity beyond addiction and the practice
          of acting with care while accepting uncertain outcomes.
        </p>

        <span>
          EXPLORE →
        </span>

      <% end %>


      <!-- STOICISM -->
      <%= link_to addiction_perspectives_stoicism_path,
          class: "bipolar-perspective-card bp-card-purple" do %>

        <p class="bipolar-perspective-number">
          03
        </p>

        <h3>
          STOICISM
        </h3>

        <p class="bipolar-perspective-description">
          Judgment, desire, responsibility, and what is yours
          to act on. Approach setbacks with resourcefulness
          and consider how your daily actions express your values.
        </p>

        <span>
          FOCUS ON WHAT'S YOURS →
        </span>

      <% end %>


      <!-- CBT -->
      <%= link_to addiction_perspectives_cbt_path,
          class: "bipolar-perspective-card bp-card-black" do %>

        <p class="bipolar-perspective-number">
          04
        </p>

        <h3>
          CBT
        </h3>

        <p class="bipolar-perspective-description">
          Thoughts, expectations, learned behavior, and the stories
          you tell yourself. Examine the evidence, recognize
          distortions, and develop a more accurate account
          of your experience.
        </p>

        <span>
          QUESTION THE THOUGHT →
        </span>

      <% end %>


      <!-- DBT -->
      <%= link_to addiction_perspectives_dbt_path,
          class: "bipolar-perspective-card bp-card-split" do %>

        <p class="bipolar-perspective-number">
          05
        </p>

        <h3>
          DBT
        </h3>

        <p class="bipolar-perspective-description">
          Acceptance and change, emotion regulation, distress
          tolerance, mindfulness, and relationships. Develop
          practical skills that support recovery and a life
          you want to participate in.
        </p>

        <span>
          FIND THE MIDDLE →
        </span>

      <% end %>


      <!-- IFS -->
      <%= link_to addiction_perspectives_ifs_path,
          class: "bipolar-perspective-card bp-card-pink" do %>

        <p class="bipolar-perspective-number">
          06
        </p>

        <h3>
          IFS
        </h3>

        <p class="bipolar-perspective-description">
          Get curious about the parts of you carrying pain,
          seeking relief, demanding control, or holding shame.
          Understand what a behavior was trying to accomplish
          while considering its effects on your whole life.
        </p>

        <span>
          MEET YOUR PARTS →
        </span>

      <% end %>


      <!-- THE BIG PICTURE -->
      <%= link_to addiction_perspectives_big_picture_path,
          class: "bipolar-perspective-card bp-card-big-picture" do %>

        <p class="bipolar-perspective-number">
          07 / PUTTING IT ALL TOGETHER
        </p>

        <h3>
          THE BIG<br>
          PICTURE
        </h3>

        <p class="bipolar-perspective-description">
          Buddhism. Hinduism. Stoicism. CBT. DBT. IFS.
          Bring the perspectives into conversation with treatment,
          community, accountability, and everyday life.
          Consider what each offers and how it fits
          your own recovery.
        </p>

        <span>
          PUT IT ALL TOGETHER →
        </span>

      <% end %>

    </div>

  </section>

</main>