<% content_for :title, "Perspectives on Addiction | Bipolar Sober" %>

<main class="bipolar-perspectives-page addiction-perspectives-index">

  <!-- HERO -->
  <section class="bipolar-perspectives-hero">

    <div class="bipolar-perspectives-hero-content">

      <p class="bipolar-perspectives-eyebrow">
        BIPOLAR SOBER / ADDICTION / PERSPECTIVES
      </p>

      <h1>
        <span>ANOTHER</span>
        <span>WAY TO</span>
        <span>LOOK AT IT.</span>
      </h1>

      <p class="bipolar-perspectives-intro">
        MORE THAN ONE STORY.<br>
        DIFFERENT FUCKING LENSES.
      </p>

      <a href="#addiction-perspective-options"
         class="bipolar-perspectives-button">
        CHANGE THE VIEW ↓
      </a>

    </div>

  </section>


  <!-- STORIES / CONTEXT -->
  <section class="bipolar-perspectives-topics"
           id="addiction-stories">

    <div class="bipolar-perspectives-heading">

      <p>START WITH THE STORIES</p>

      <h2>
        BEFORE<br>
        THE LENSES.
      </h2>

      <p class="bipolar-perspectives-subtitle">
        Read these stories first for context. The perspectives below
        return to these experiences to examine the decisions,
        circumstances, consequences, and patterns involved.
        Same stories. Different ways of understanding what happened.
      </p>

    </div>

    <div class="bipolar-perspectives-grid">

      <!-- FIRST DUI -->
      <%= link_to addiction_perspectives_first_dui_path,
          class: "bipolar-perspective-card bp-card-yellow" do %>

        <p class="bipolar-perspective-number">01 / THE STORY</p>

        <h3>
          FIRST<br>
          DUI
        </h3>

        <p class="bipolar-perspective-description">
          Read the account of my first DUI before exploring
          how the different perspectives interpret the experience.
        </p>

        <span>READ THE STORY →</span>

      <% end %>


      <!-- THIRD DUI -->
      <%= link_to addiction_perspectives_third_dui_path,
          class: "bipolar-perspective-card bp-card-pink" do %>

        <p class="bipolar-perspective-number">02 / THE STORY</p>

        <h3>
          THIRD<br>
          DUI
        </h3>

        <p class="bipolar-perspective-description">
          Read the account of my third DUI for the context
          behind the reflections on responsibility,
          mental illness, addiction, and consequences.
        </p>

        <span>READ THE STORY →</span>

      <% end %>


      <!-- PRESS SEND -->
      <%= link_to addiction_perspectives_press_send_path,
          class: "bipolar-perspective-card bp-card-purple" do %>

        <p class="bipolar-perspective-number">03 / THE STORY</p>

        <h3>
          PRESS<br>
          SEND.
        </h3>

        <p class="bipolar-perspective-description">
          Drunk texts. Impulsive words. Sober consequences.
          An account of the things I said while intoxicated,
          the relationships affected, and what happens
          when you can't take back what you've sent.
        </p>

        <span>READ THE STORY →</span>

      <% end %>

    </div>

  </section>


  <!-- PERSPECTIVES -->
  <section class="bipolar-perspectives-topics"
           id="addiction-perspective-options">

    <div class="bipolar-perspectives-heading">

      <p>01 / PERSPECTIVES ON ADDICTION</p>

      <h2>
        PICK A<br>
        LENS.
      </h2>

      <p class="bipolar-perspectives-subtitle">
        Addiction involves behavior, suffering, habits, relationships,
        and the environments in which you learn to live. Explore
        different ways to understand your experience, take responsibility,
        and build a life in recovery.
      </p>

    </div>


    <div class="bipolar-perspectives-grid">

      <!-- BUDDHISM -->
      <%= link_to addiction_perspectives_buddhism_path,
          class: "bipolar-perspective-card bp-card-pink" do %>

        <p class="bipolar-perspective-number">01</p>

        <h3>BUDDHISM</h3>

        <p class="bipolar-perspective-description">
          Suffering, craving, attachment, impermanence,
          mindfulness, and compassion. Examine your relationship
          with relief and what it means to live with greater awareness.
        </p>

        <span>LOOK A LITTLE CLOSER →</span>

      <% end %>


      <!-- HINDUISM -->
      <%= link_to addiction_perspectives_hinduism_path,
          class: "bipolar-perspective-card bp-card-yellow" do %>

        <p class="bipolar-perspective-number">02</p>

        <h3>HINDUISM</h3>

        <p class="bipolar-perspective-description">
          The Self, discernment, dharma, devotion, and non-harming.
          Explore identity beyond addiction and the practice
          of acting with care while accepting uncertain outcomes.
        </p>

        <span>EXPLORE →</span>

      <% end %>


      <!-- STOICISM -->
      <%= link_to addiction_perspectives_stoicism_path,
          class: "bipolar-perspective-card bp-card-purple" do %>

        <p class="bipolar-perspective-number">03</p>

        <h3>STOICISM</h3>

        <p class="bipolar-perspective-description">
          Judgment, desire, responsibility, and what is yours
          to act on. Approach setbacks with resourcefulness
          and consider how your daily actions express your values.
        </p>

        <span>FOCUS ON WHAT'S YOURS →</span>

      <% end %>


      <!-- CBT -->
      <%= link_to addiction_perspectives_cbt_path,
          class: "bipolar-perspective-card bp-card-black" do %>

        <p class="bipolar-perspective-number">04</p>

        <h3>CBT</h3>

        <p class="bipolar-perspective-description">
          Thoughts, expectations, learned behavior, and the stories
          you tell yourself. Examine the evidence, recognize
          distortions, and develop a more accurate account
          of your experience.
        </p>

        <span>QUESTION THE THOUGHT →</span>

      <% end %>


      <!-- DBT -->
      <%= link_to addiction_perspectives_dbt_path,
          class: "bipolar-perspective-card bp-card-split" do %>

        <p class="bipolar-perspective-number">05</p>

        <h3>DBT</h3>

        <p class="bipolar-perspective-description">
          Acceptance and change, emotion regulation, distress
          tolerance, mindfulness, and relationships. Develop
          practical skills that support recovery and a life
          you want to participate in.
        </p>

        <span>FIND THE MIDDLE →</span>

      <% end %>


      <!-- IFS -->
      <%= link_to addiction_perspectives_ifs_path,
          class: "bipolar-perspective-card bp-card-pink" do %>

        <p class="bipolar-perspective-number">06</p>

        <h3>IFS</h3>

        <p class="bipolar-perspective-description">
          Get curious about the parts of you carrying pain,
          seeking relief, demanding control, or holding shame.
          Understand what a behavior was trying to accomplish
          while considering its effects on your whole life.
        </p>

        <span>MEET YOUR PARTS →</span>

      <% end %>


      <!-- SHINTO -->
      <%= link_to addiction_perspectives_shinto_path,
          class: "bipolar-perspective-card bp-card-yellow" do %>

        <p class="bipolar-perspective-number">07</p>

        <h3>SHINTO</h3>

        <p class="bipolar-perspective-description">
          Sincerity, relationship, renewal, and care for the life
          around you. Consider what these ideas can offer recovery.
        </p>

        <span>EXPLORE THE LENS →</span>

      <% end %>


      <!-- TAOISM -->
      <%= link_to addiction_perspectives_taoism_path,
          class: "bipolar-perspective-card bp-card-purple" do %>

        <p class="bipolar-perspective-number">08</p>

        <h3>TAOISM</h3>

        <p class="bipolar-perspective-description">
          Adaptability, balance, simplicity, and responding without
          forcing an outcome. A different lens on change and recovery.
        </p>

        <span>EXPLORE THE LENS →</span>

      <% end %>


      <!-- PAGANISM -->
      <%= link_to addiction_perspectives_paganism_path,
          class: "bipolar-perspective-card bp-card-pink" do %>

        <p class="bipolar-perspective-number">09</p>

        <h3>PAGANISM</h3>

        <p class="bipolar-perspective-description">
          Nature, cycles, ritual, reciprocity, and personal meaning.
          Explore how these ideas might connect with living in recovery.
        </p>

        <span>EXPLORE THE LENS →</span>

      <% end %>


      <!-- THE BIG PICTURE -->
      <%= link_to addiction_perspectives_big_picture_path,
          class: "bipolar-perspective-card bp-card-big-picture" do %>

        <p class="bipolar-perspective-number">
          10 / PUTTING IT ALL TOGETHER
        </p>

        <h3>
          THE BIG<br>
          PICTURE
        </h3>

        <p class="bipolar-perspective-description">
          Buddhism. Hinduism. Stoicism. CBT. DBT. IFS.
          Shinto. Taoism. Paganism. Bring these perspectives
          into conversation with treatment, community, accountability,
          and everyday life. Consider what each offers and how it fits
          your own recovery.
        </p>

        <span>PUT IT ALL TOGETHER →</span>

      <% end %>

    </div>

  </section>

</main>